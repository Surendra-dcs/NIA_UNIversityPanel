                    <div class="item">
                        <span class="no">6.</span>
                        <div class="txt">
                            <div class="legend hi"><span>D-डिस्टिंक्शन</span><span>G- कृपांक</span><span>F-अनुत्तीर्ण</span><span>AB-अनुपस्थित</span></div>
                            <div class="legend en"><span>D-Distinction</span><span>G-Grace</span><span>F-Fail</span><span>Ab-Absent</span></div>
                        </div>
                    </div>
                </div>

                <div class="spacer"></div>

                <!-- Footer -->
                <div class="foot">
                    <div class="left">
                        <div class="place">
                            जयपुर<br>
                            <span class="en-serif">Jaipur</span>
                            <span class="small">परिणाम घोषित दिनांक</span>
                            <span class="small"> Result Date: <span id="resultDate"></span></span>
                        </div>
                        <div class="qr" id="qr"></div>
                    </div>
                    <div class="right">
                        <img src="@Url.Content("~/images/sig_coe.png")" alt="" onerror="this.style.display='none'">
                        <div class="coe-hi">परीक्षा नियंत्रक</div>
                        <div class="coe-en">CONTROLLER OF EXAMINATIONS</div>
                    </div>
                </div>

            </div>

            <!-- Bottom Serial (frame ke neeche) -->
            <div class="serial-bottom" id="serialbottom"></div>
        </div>
    </div>

    <!-- =================== PRINT POPUP =================== -->
    <div id="printModal" class="print-modal">
        <div class="print-modal-content">

            <div class="print-modal-header">
                <h3>Print Marksheet</h3>
                <button type="button" class="print-modal-close" onclick="closePrintPopup()">&times;</button>
            </div>

            <div class="print-modal-body">
                <div class="print-input-group">
                    <label for="printSerialNo">Serial No.</label>
                    <input type="text" id="printSerialNo" class="print-input" placeholder="Enter Serial No.">
                </div>

                <div class="print-input-group">
                    <label for="printFolioNo">Folio No.</label>
                    <input type="text" id="printFolioNo" class="print-input" placeholder="Enter Folio No.">
                </div>

                <div class="print-input-group">
                    <label for="printBottomSerial">Bottom Serial No.</label>
                    <input type="text" id="printBottomSerial" class="print-input" placeholder="Enter Bottom Serial No.">
                </div>
            </div>

            <div class="print-modal-footer">
                <button type="button" class="print-cancel-btn" onclick="closePrintPopup()">Cancel</button>
                <button type="button" class="print-save-btn" onclick="saveAndPrint()">Save &amp; Print</button>
            </div>

        </div>
    </div>

    <script>
        // =====================================================
        // CONFIG
        // =====================================================
        const VERIFY_URL = 'https://nia.edu.in/resultverification.php?uuid=';

        // =====================================================
        // FIELD MAPPING  (SP column names - case-insensitive)
        // Column ka naam alag ho to yahan array me add kar dijiye.
        // =====================================================
        const F = {
            serialNo:   ['SerialNo', 'Serialno', 'SNo'],
            folioNo:    ['Folio', 'FolioNo', 'UniqueCode'],
            serialBottom: ['SerialBottom', 'BottomSerialNo', 'BottomSerial'],
            uuid:       ['UUID', 'Uuid', 'ResultUUID', 'ResultGuid', 'VerificationId', 'GuidId'],

            // Poori exam line, e.g. "M.D. (Ay.) Agada Tantra Part-II Odd BATCH-2022 MAIN EXAM (September 2026)"
            // -> isi se Course / Specialization / Part / Month-Year nikale jaate hain
            examFull:   ['Examname', 'ExamFullName'],
            session:    ['ExaminationName', 'ExamSession'],                     // "September (2026)"

            // Neeche wale SP se aaye to wahi use honge, warna Examname se ban jaayenge
            stmtEn:     ['StatementEn', 'StatementTitle'],
            stmtHi:     ['StatementHi', 'StatementTitleHindi'],
            courseEn:   ['CourseName', 'CourseNameEn'],
            courseHi:   ['CourseHindiName', 'CourseNameHindi', 'ExamnameHindi'],
            specEn:     ['SpecializationName', 'Specialization', 'DepartmentName'],
            specHi:     ['SpecializationHindi', 'SpecializationHindiName', 'DepartmentHindi'],
            heldOn:     ['ExamHeld', 'ExamHeldOn', 'ExamMonthYear'],

            nameHi:     ['CondidateHindi', 'CandidateHindi', 'CandidateHindiName'],
            nameEn:     ['CandidateName'],
            fatherHi:   ['FatherHindiName'],
            fatherEn:   ['FatherName'],
            motherHi:   ['MotherHindiName'],
            motherEn:   ['MotherName'],
            rollNo:     ['RollNumber', 'RollNo'],
            enrollNo:   ['EnrollmentNumber', 'EnrollmentNo'],
            attempt:    ['Attempt'],
            resultDate: ['Declaredate', 'ResultDate'],
            result:     ['Result'],
            grandTotal: ['GrandTotal'],

            // ---- per subject row ----
            paperEn:    ['PaperName', 'SubjectName', 'SubjectAppearing'],
            paperHi:    ['PaperHindiName', 'SubjectHindiName', 'SubjectNameHindi', 'SubjectHindiAppearing'],
            codeEn:     ['SubjectCodeType', 'SubjectCode'],
            codeHi:     ['SubjectHindiCodeType', 'SubjectHindiCode'],
            theory:     ['TheoryObtained'],
            practical:  ['PracticalObtained'],
            theoryMax:  ['TheoryMax'],
            practMax:   ['PracticalMax'],
            theoryMin:  ['TheoryMin'],
            practMin:   ['PracticalMin'],
            maxTotal:   ['MarksSchemeTotal', 'MaxMarks'],
            minTotal:   ['MarksSchemeMin', 'MinMarks'],
            total:      ['ObtainedTotal', 'SubjectTotal'],
            distinction:['Distinction'],
            grace:      ['GraceMarks'],
            remark:     ['Remarks', 'Remark']
        };

        // =====================================================
        // HELPERS
        // =====================================================
        const isBlank = v => v === null || v === undefined || String(v).trim() === '';

        // Case-insensitive pick: "CandidateName" / "candidateName" dono chalega
        function pick(obj, keys) {
            if (!obj) return '';
            const lower = {};
            Object.keys(obj).forEach(k => { lower[k.toLowerCase()] = obj[k]; });
            for (const k of keys) {
                const v = (k in obj) ? obj[k] : lower[k.toLowerCase()];
                if (!isBlank(v)) return String(v).trim();
            }
            return '';
        }

        function setText(id, value) {
            const el = document.getElementById(id);
            if (el) el.textContent = isBlank(value) ? '' : value;
        }

        function setHtml(id, html) {
            const el = document.getElementById(id);
            if (el) el.innerHTML = html;
        }

        function esc(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function num(value) {
            if (isBlank(value)) return 0;
            const n = Number(value);
            return Number.isFinite(n) ? n : 0;
        }

        const isAbsent = v => /^(AB|ABS|ABSENT)$/i.test(String(v ?? '').trim());

        function formatDate(value) {
            if (!value) return '';
            const d = new Date(value);
            if (isNaN(d.getTime())) return value;
            return `${String(d.getDate()).padStart(2, '0')}-${String(d.getMonth() + 1).padStart(2, '0')}-${d.getFullYear()}`;
        }

        const EN_MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
        const HI_MONTHS = {
            january:'जनवरी', february:'फरवरी', march:'मार्च', april:'अप्रैल', may:'मई', june:'जून',
            july:'जुलाई', august:'अगस्त', september:'सितम्बर', october:'अक्टूबर', november:'नवम्बर', december:'दिसम्बर'
        };

        function heldText(v) {
            if (isBlank(v)) return '';
            if (/^\d{4}-\d{2}/.test(v)) {
                const d = new Date(v);
                if (!isNaN(d.getTime())) return `${EN_MONTHS[d.getMonth()]} ${d.getFullYear()}`;
            }
            return v;
        }
        const toHindiMonth = s => String(s).replace(/[A-Za-z]+/g, w => HI_MONTHS[w.toLowerCase()] || w);

        // =====================================================
        // EXAM NAME PARSER
        // "M.D. (Ay.) Agada Tantra Part-II Odd BATCH-2022 MAIN EXAM (September 2026)"
        //   -> degree MD, spec "Agada Tantra", part II, month September, year 2026
        // =====================================================
        const DEGREES = {
            MD:  { en: 'M.D. (Ayurveda)',  hi: 'आयुर्वेद वाचस्पति', abbrHi: 'एम.डी. (आयुर्वेद)' },
            MS:  { en: 'M.S. (Ayurveda)',  hi: 'आयुर्वेद धन्वन्तरि', abbrHi: 'एम.एस. (आयुर्वेद)' },
            PHD: { en: 'Ph.D. (Ayurveda)', hi: 'विद्या वारिधि',     abbrHi: 'पीएच.डी. (आयुर्वेद)' }
        };
        const PART_HI = { I: 'प्रथम', II: 'द्वितीय', III: 'तृतीय', IV: 'चतुर्थ' };
        const ROMAN   = { '1': 'I', '2': 'II', '3': 'III', '4': 'IV' };

        // Specialization -> Hindi (zarurat ho to aur add kar dijiye)
        const SPEC_HI = [
            [/agad/i,                    'अगदतंत्र'],
            [/kaya\s*chikitsa/i,         'कायचिकित्सा'],
            [/panch\s*karma/i,           'पंचकर्म'],
            [/rasa\s*shastra/i,          'रसशास्त्र एवं भैषज्य कल्पना'],
            [/dravya\s*guna/i,           'द्रव्यगुण'],
            [/kaumar|bal\s*roga/i,       'कौमारभृत्य'],
            [/prasuti|stri\s*roga/i,     'प्रसूति तंत्र एवं स्त्री रोग'],
            [/shalakya/i,                'शालाक्य तंत्र'],
            [/shalya/i,                  'शल्य तंत्र'],
            [/rachana/i,                 'रचना शारीर'],
            [/kriya\s*sharir/i,          'क्रिया शारीर'],
            [/roga\s*nidan|vikriti/i,    'रोग निदान एवं विकृति विज्ञान'],
            [/swastha/i,                 'स्वस्थवृत्त एवं योग'],
            [/samhita|siddhant|basic/i,  'संहिता एवं सिद्धांत'],
            [/manas/i,                   'मानस रोग']
        ];

        function parseExam(full, session) {
            const out = { deg: null, part: '', spec: '', month: '', year: '' };
            const s = String(full || '').replace(/\s+/g, ' ').trim();

            const m = s.match(/^(M\.?\s*D|M\.?\s*S|Ph\.?\s*D)\.?\s*\(\s*(?:Ay|Ayu|Ayurveda)\.?\s*\)\s*(.*?)\s*Part[\s\-–]*([IVX]+|\d)\b/i);
            if (m) {
                out.deg  = DEGREES[m[1].replace(/[\s.]/g, '').toUpperCase()] || null;
                out.spec = m[2].trim();
                out.part = ROMAN[m[3]] || m[3].toUpperCase();
            }

            const h = s.match(/\(\s*([A-Za-z]+)[\s,\-]*(\d{4})\s*\)/) ||
                      String(session || '').match(/([A-Za-z]+)[\s(,\-]*(\d{4})/);
            if (h) {
                out.month = h[1].charAt(0).toUpperCase() + h[1].slice(1).toLowerCase();
                out.year  = h[2];
            }
            return out;
        }

        // QR ke liye Examname sirf "Part-II" tak:
        // "M.S. (Ay.) Shalya Tantra Part-II Odd BATCH-2022 MAIN EXAM (September 2026)" -> "M.S. (Ay.) Shalya Tantra Part-II"
        function qrCourse(full) {
            const s = String(full || '').replace(/\s+/g, ' ').trim();
            const m = s.match(/^.*?Part[\s\-–]*(?:[IVX]+|\d)\b/i);
            return m ? m[0].trim() : s;
        }

        function specToHindi(spec) {
            for (const [re, hi] of SPEC_HI) if (re.test(spec)) return hi;
            return '';
        }

        function toHindiCode(code) {
            return String(code || '')
                .replace(/\bMD\b/gi, 'एमडी')
                .replace(/\bPR\b/gi, 'प्रायो.');
        }

        function withCode(code, name) {
            name = String(name || '').trim();
            code = String(code || '').trim();
            if (!code || name.startsWith('(')) return name;
            return `(${code}) ${name}`;
        }

        function ordinalHtml(v) {
            const n = parseInt(v, 10);
            if (isNaN(n)) return esc(v);
            const s = (n % 100 >= 11 && n % 100 <= 13) ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] || 'th');
            return `${n}<sup>${s}</sup>`;
        }

        function bothNames(hi, en) {
            en = String(en || '').toUpperCase();
            if (hi && en) return `${hi} / ${en}`;
            return hi || en;
        }

        function markCell(v, max) {
            if (isBlank(v)) return '-';
            if (isAbsent(v)) return 'AB';
            if (max === 0 && num(v) === 0) return '-';
            return v;
        }

        // =====================================================
        // FETCH
        // =====================================================
        async function loadMarksheet() {

            const enrollmentNumber = EnrollmentNumber;
            const examId = ExamId;

            if (!enrollmentNumber || !examId) {
                alert("Enrollment Number or Exam ID is missing.");
                return;
            }

            try {

                const url = ApiBaseUrl +
                    `Result/GetMarsheetDataBAMSII?enrollmentNumber=${encodeURIComponent(enrollmentNumber)}&examId=${encodeURIComponent(examId)}`;

                console.log("Marksheet API URL:", url);

                const response = await fetch(url);

                if (!response.ok) {
                    let msg = "Unable to fetch marksheet data.";
                    try {
                        const e = await response.json();
                        msg = e.message || msg;
                    } catch (e) { }
                    alert(msg);
                    return;
                }

                const result = await response.json();

                console.log("Marksheet API Response:", result);

                if (!Array.isArray(result) || result.length === 0) {
                    alert("No marksheet data found.");
                    return;
                }

                bindMarksheet(result);
            }
            catch (error) {
                console.error("Marksheet Error:", error);
                alert("Something went wrong while loading marksheet.");
            }
        }

        // =====================================================
        // BIND
        // =====================================================
        function bindMarksheet(data) {
            const st = data[0];

            // ---------- Serial / Folio ----------
            setText('serialNo', pick(st, F.serialNo));
            setText('folioNo',  pick(st, F.folioNo));
            setText('serialbottom', pick(st, F.serialBottom));

            // ---------- Examname parse ----------
            const ex      = parseExam(pick(st, F.examFull), pick(st, F.session));
            const part    = ex.part;
            const partHi  = PART_HI[part] || part;
            const isFinal = part === 'II';
            const year    = ex.year;

            // ---------- Statement title ----------
            // "Statement of Marks obtained at the M.D. (AYURVEDA) PART-II (Final) Examination-2026"
            const stmtEn = pick(st, F.stmtEn) || (ex.deg
                ? `Statement of Marks obtained at the ${ex.deg.en.toUpperCase()} PART-${part}${isFinal ? ' (Final)' : ''} Examination-${year}`
                : '');
            // "एम.डी. (आयुर्वेद) पार्ट-द्वितीय (अंतिम) परीक्षा-2026 में प्राप्त अंकों का विवरण"
            const stmtHi = pick(st, F.stmtHi) || (ex.deg
                ? `${ex.deg.abbrHi} पार्ट-${partHi}${isFinal ? ' (अंतिम)' : ''} परीक्षा-${year} में प्राप्त अंकों का विवरण`
                : '');
            setText('stmtEn', stmtEn);
            setText('stmtHi', stmtHi);

            // ---------- Course block ----------
            const courseEn = pick(st, F.courseEn) || (ex.deg ? `${ex.deg.en} Part-${part}` : pick(st, F.examFull));
            const courseHi = pick(st, F.courseHi) || (ex.deg ? `${ex.deg.hi} भाग-${partHi}` : '');
            const specEn   = pick(st, F.specEn)   || ex.spec;
            const specHi   = pick(st, F.specHi)   || specToHindi(specEn);

            setText('courseEn', courseEn);
            setText('courseHi', courseHi);
            setText('specEn',   specEn);
            setText('specHi',   specHi);

            const held = heldText(pick(st, F.heldOn)) || (ex.month ? `${ex.month} ${ex.year}` : '');
            setText('examEn', held ? `(Examination Held in ${held})` : '');
            setText('examHi', held ? `(परीक्षा सम्पादित ${toHindiMonth(held)})` : '');

            // ---------- Student ----------
            setText('nameBoth',   bothNames(pick(st, F.nameHi),   pick(st, F.nameEn)));
            setText('fatherBoth', bothNames(pick(st, F.fatherHi), pick(st, F.fatherEn)));
            setText('motherBoth', bothNames(pick(st, F.motherHi), pick(st, F.motherEn)));
            setText('rollNo',     pick(st, F.rollNo));
            setText('enrollNo',   pick(st, F.enrollNo));
            setHtml('attempt',    ordinalHtml(pick(st, F.attempt)));
            setText('resultDate', formatDate(pick(st, F.resultDate)));

            // ---------- Subject rows ----------
            let html = '', sumTotal = 0, sumMax = 0, sumMin = 0;
            const distHi = [], distEn = [], graceHi = [], graceEn = [], failHi = [], failEn = [];

            data.forEach(s => {
                const theory    = pick(s, F.theory);
                const practical = pick(s, F.practical);

                const tMax = num(pick(s, F.theoryMax)), pMax = num(pick(s, F.practMax));
                const tMin = num(pick(s, F.theoryMin)), pMin = num(pick(s, F.practMin));

                const maxMarks = num(pick(s, F.maxTotal)) || (tMax + pMax);
                const minMarks = num(pick(s, F.minTotal)) || (tMin + pMin);

                const apiTotal = pick(s, F.total);
                const total = apiTotal !== '' ? num(apiTotal) : num(theory) + num(practical);

                sumTotal += total; sumMax += maxMarks; sumMin += minMarks;

                const codeEn = pick(s, F.codeEn);
                const codeHi = pick(s, F.codeHi) || toHindiCode(codeEn);

                // ---- Fail check ----
                let fail = false;
                if (!isBlank(theory)    && (tMax > 0 || num(theory) > 0)    && (isAbsent(theory)    || num(theory)    < tMin)) fail = true;
                if (!isBlank(practical) && (pMax > 0 || num(practical) > 0) && (isAbsent(practical) || num(practical) < pMin)) fail = true;

                const dVal = pick(s, F.distinction).toUpperCase();
                const isDist = ['D', 'Y', 'YES', 'TRUE', '1'].includes(dVal);
                const hasGrace = num(pick(s, F.grace)) > 0;

                // ---- Remark: API ka ho to wahi, warna calculate ----
                let remark = pick(s, F.remark).toUpperCase();
                if (!remark) {
                    if (fail) remark = (isAbsent(theory) || isAbsent(practical)) ? 'AB' : 'F';
                    else if (hasGrace) remark = 'G';
                    else if (isDist) remark = 'D';
                }

                if (remark === 'F' || remark === 'AB') { failHi.push(codeHi);  failEn.push(codeEn); }
                else if (remark === 'G')               { graceHi.push(codeHi); graceEn.push(codeEn); }
                else if (remark === 'D')               { distHi.push(codeHi);  distEn.push(codeEn); }

                html += `
                    <tr class="${remark === 'G' ? 'grace-row' : ''}">
                        <td class="sub">
                            <div class="hi">${esc(withCode(codeHi, pick(s, F.paperHi)))}</div>
                            <div class="en">${esc(withCode(codeEn, pick(s, F.paperEn)))}</div>
                        </td>
                        <td class="num">${esc(maxMarks)}</td>
                        <td class="num">${esc(minMarks)}</td>
                        <td class="num">${esc(markCell(theory, tMax))}</td>
                        <td class="num">${esc(markCell(practical, pMax))}</td>
                        <td class="tot">${esc(total)}</td>
                        <td class="num">${esc(remark)}</td>
                    </tr>`;
            });

            setHtml('rows', html);

            // ---------- Totals ----------
            setText('maxAll', sumMax);
            setText('minAll', sumMin);

            const apiGT = pick(st, F.grandTotal);
            const grandTotal = apiGT !== '' ? num(apiGT) : sumTotal;
            setText('grandTotal', grandTotal);

            // ---------- Summary ----------
            const join = arr => arr.filter(Boolean).join(', ');
            setText('distHi',  join(distHi));
            setText('distEn',  join(distEn));
            setText('graceHi', join(graceHi));
            setText('graceEn', join(graceEn));
            setText('failHi',  join(failHi));
            setText('failEn',  join(failEn));

            // ---------- Result ----------
            let res = pick(st, F.result).toUpperCase();
            if (!res) res = failEn.length ? 'FAIL' : 'PASS';

            const RES_HI = { 'PASS': 'उत्तीर्ण', 'FAIL': 'अनुत्तीर्ण', 'ABSENT': 'अनुपस्थित' };
            setText('resultText', RES_HI[res] ? `${RES_HI[res]}/${res}` : res);

            // ---------- QR ----------
            generateQRCode({
                rollNo:  pick(st, F.rollNo),
                name:    pick(st, F.nameEn).toUpperCase(),
                course:  qrCourse(pick(st, F.examFull)) || courseEn,   // "M.S. (Ay.) Shalya Tantra Part-II"
                result:  res,
                total:   grandTotal,
                uuid:    pick(st, F.uuid)
            });
        }

        // =====================================================
        // QR CODE
        // Format:
        // Roll No: 2202033; Name: DHARTI; Course: M.D.(Ayurveda) Part-II; Result: PASS; Total Marks: 412;Url: https://nia.edu.in/resultverification.php?uuid=...
        // =====================================================
        function generateQRCode(q) {
            const qr = document.getElementById('qr');
            if (!qr) return;
            qr.innerHTML = '';

            if (typeof QRCode === 'undefined') {
                console.warn('QR Code library not loaded.');
                return;
            }

            const text =
                `Roll No: ${q.rollNo}; ` +
                `Name: ${q.name}; ` +
                `Course: ${q.course}; ` +
                `Result: ${q.result}; ` +
                `Total Marks: ${q.total};` +
                `Url: ${VERIFY_URL}${encodeURIComponent(q.uuid)}`;

            console.log("QR Text:", text);

            new QRCode(qr, { text: text, width: 256, height: 256, correctLevel: QRCode.CorrectLevel.M });
        }

        // =====================================================
        // PRINT FIT: content zyada ho to frame ko chhota (zoom) kar do
        // taaki border + footer ek hi page par aaye
        // =====================================================
        const MM = 96 / 25.4;   // 1mm in px

        function fitForPrint() {
            const frame = document.querySelector('.frame');
            if (!frame) return;

            frame.style.zoom = '';
            frame.style.height = 'auto';
            frame.style.minHeight = '0';

            const available = 283 * MM;
            const needed    = frame.scrollHeight;

            const z = needed > available ? (available / needed) : 1;

            frame.style.height = '';
            frame.style.minHeight = '';
            if (z < 1) {
                frame.style.zoom = z.toFixed(3);
                frame.style.height = (283 / z) + 'mm';
            }
        }

        function resetAfterPrint() {
            const frame = document.querySelector('.frame');
            if (!frame) return;
            frame.style.zoom = '';
            frame.style.height = '';
            frame.style.minHeight = '';
        }

        window.addEventListener('beforeprint', fitForPrint);
        window.addEventListener('afterprint', resetAfterPrint);

        // =====================================================
        // PRINT POPUP  (Serial No / Folio No / Bottom Serial)
        // =====================================================
        const $id = id => document.getElementById(id);

        function openPrintPopup() {
            $id('printSerialNo').value     = $id('serialNo').textContent.trim();
            $id('printFolioNo').value      = $id('folioNo').textContent.trim();
            $id('printBottomSerial').value = $id('serialbottom').textContent.trim();

            $id('printModal').style.display = 'flex';
            $id('printSerialNo').focus();
        }

        function closePrintPopup() {
            $id('printModal').style.display = 'none';
        }

        function saveAndPrint() {
            const serialNo  = $id('printSerialNo').value.trim();
            const folioNo   = $id('printFolioNo').value.trim();
            const bottomNo  = $id('printBottomSerial').value.trim();

            if (!serialNo) { alert('Please enter Serial No.');        $id('printSerialNo').focus();     return; }
            if (!folioNo)  { alert('Please enter Folio No.');         $id('printFolioNo').focus();      return; }
            if (!bottomNo) { alert('Please enter Bottom Serial No.'); $id('printBottomSerial').focus(); return; }

            // Marksheet me set
            $id('serialNo').textContent     = serialNo;
            $id('folioNo').textContent      = folioNo;
            $id('serialbottom').textContent = bottomNo;

            closePrintPopup();

            // DOM update ke baad print
            setTimeout(() => window.print(), 200);
        }

        // ESC se band
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && $id('printModal').style.display === 'flex') closePrintPopup();
        });

        // Bahar click se band
        document.addEventListener('click', e => {
            if (e.target && e.target.id === 'printModal') closePrintPopup();
        });

        // Popup me Enter dabane par Save & Print
        document.addEventListener('keydown', e => {
            if (e.key === 'Enter' && $id('printModal').style.display === 'flex') {
                e.preventDefault();
                saveAndPrint();
            }
        });

        document.addEventListener('DOMContentLoaded', loadMarksheet);
    </script>

</body>
</html>
