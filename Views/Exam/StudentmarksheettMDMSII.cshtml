@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Marksheet";
    Layout = null;

    string apiBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "";
    string enrollment = Convert.ToString(ViewBag.enrollment) ?? "";
    string examId = Convert.ToString(ViewBag.examId) ?? "";
}
<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Statement of Marks</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Devanagari:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script>
        var ApiBaseUrl       = @Json.Serialize(apiBaseUrl);
        var EnrollmentNumber = @Json.Serialize(enrollment);
        var ExamId           = @Json.Serialize(examId);
    </script>

    <style>
        @@page {
            size: A4 portrait;
            margin: 0;
        }

        * {
            box-sizing: border-box;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        html, body {
            margin: 0;
            padding: 0;
            background: #d9dde3;
        }

        body {
            font-family: "Noto Serif Devanagari", "Times New Roman", Times, serif;
            color: #111;
        }

        .en-serif {
            font-family: "Times New Roman", Times, serif;
        }

        .en-sans {
            font-family: Arial, Helvetica, sans-serif;
        }

        /* ---------- toolbar (screen only) ---------- */
        .toolbar {
            position: sticky;
            top: 0;
            z-index: 10;
            padding: 10px;
            text-align: center;
        }

            .toolbar button {
                background: #2563eb;
                color: #fff;
                border: none;
                border-radius: 6px;
                padding: 9px 26px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
            }

                .toolbar button:hover {
                    background: #1d4ed8;
                }

        /* ---------- A4 page ---------- */
        .sheet-wrap {
            padding: 18px 0 40px;
            display: flex;
            justify-content: center;
        }

        .page {
            width: 210mm;
            min-height: 297mm;
            background: #fff;
            padding: 9mm 10mm 8mm;
            box-shadow: 0 8px 30px rgba(0,0,0,.25);
            position: relative;
        }

        /* ---------- bottom serial (frame ke neeche, right side) ---------- */
        .serial-bottom {
            position: absolute;
            right: 10mm;
            bottom: 3mm;
            font-size: 9px;
            font-weight: 700;
            font-family: Arial, Helvetica, sans-serif;
        }

        /* ---------- grace subject: poori row yellow ---------- */
        table.marks tr.grace-row > td {
            background: yellow !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* ---------- PRINT POPUP (Serial / Folio / Bottom Serial) ---------- */
        .print-modal {
            display: none;
            position: fixed;
            z-index: 99999;
            inset: 0;
            background: rgba(0, 0, 0, 0.55);
            align-items: center;
            justify-content: center;
            font-family: Arial, Helvetica, sans-serif;
        }

        .print-modal-content {
            width: 420px;
            max-width: 90%;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            animation: printModalOpen 0.2s ease;
        }

        @@keyframes printModalOpen {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .print-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 20px;
            border-bottom: 1px solid #ddd;
        }

            .print-modal-header h3 {
                margin: 0;
                font-size: 19px;
                font-weight: 600;
            }

        .print-modal-close {
            border: none;
            background: transparent;
            font-size: 27px;
            line-height: 1;
            cursor: pointer;
            color: #666;
        }

            .print-modal-close:hover {
                color: #000;
            }

        .print-modal-body {
            padding: 20px;
        }

        .print-input-group {
            margin-bottom: 16px;
        }

            .print-input-group label {
                display: block;
                margin-bottom: 6px;
                font-size: 14px;
                font-weight: 600;
                color: #333;
            }

        .print-input {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            outline: none;
        }

            .print-input:focus {
                border-color: #2563eb;
            }

        .print-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 15px 20px;
            border-top: 1px solid #ddd;
            background: #fafafa;
        }

        .print-cancel-btn, .print-save-btn {
            padding: 9px 16px;
            border-radius: 5px;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }

        .print-cancel-btn {
            background: #e5e5e5;
            color: #333;
        }

        .print-save-btn {
            background: #2563eb;
            color: #fff;
        }

            .print-save-btn:hover {
                background: #1d4ed8;
            }

        .frame {
            border: 1.5px solid #000; 
            outline: 2.5px solid #000;
            outline-offset: 3px;
            padding: 4mm 5mm 4mm;
            min-height: 280mm;
            display: flex;
            flex-direction: column;
        }

        /* ---------- serial / folio ---------- */
        .meta-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            font-size: 12px;
            font-weight: 600;
        }

            .meta-top .folio {
                margin-top: 1mm;
            }

        /* ---------- header ---------- */
        .hdr {
            display: grid;
            grid-template-columns: 1fr 26mm 1fr;
            align-items: center;
            gap: 6px;
            margin-top: -2mm;
        }

        .hdr-left {
            text-align: center;
            line-height: 1.3;
        }

            .hdr-left .hi-main {
                font-size: 27px;
                font-weight: 700;
                color: #555;
                line-height: 1.15;
            }

            .hdr-left .hi-sub {
                font-size: 16px;
                font-weight: 600;
                color: #333;
            }

            .hdr-left .hi-small {
                font-size: 12.5px;
                color: #50c3ee;
            }

            .hdr-left .hi-addr {
                font-size: 13px;
                color: #222;
            }

        .hdr-logo {
            text-align: center;
        }

            .hdr-logo img {
                width: 24mm;
                height: 24mm;
                object-fit: contain;
            }

        .logo-fallback {
            width: 24mm;
            height: 24mm;
            border: 2px solid #777;
            border-radius: 50%;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: #777;
            text-align: center;
            margin: 0 auto;
        }

        .hdr-right {
            text-align: center;
            line-height: 1.4;
            font-family: "Times New Roman", Times, serif;
        }

            .hdr-right .en-main {
                font-size: 21px;
                font-weight: 700;
                color: #444;
                letter-spacing: .3px;
            }

            .hdr-right .en-sub {
                font-size: 14px;
                color: #333;
                font-family: Arial, Helvetica, sans-serif;
            }

            .hdr-right .en-small {
                font-size: 12.5px;
                color: #50c3ee;
                font-family: Arial, Helvetica, sans-serif;
            }

            .hdr-right .en-addr {
                font-size: 13.5px;
                color: #222;
                font-family: Arial, Helvetica, sans-serif;
            }

        /* ---------- statement title ---------- */
        .stmt {
            text-align: center;
            margin-top: 4mm;
            line-height: 1.35;
        }

            .stmt .en {
                font-size: 14.5px;
                font-weight: 700;
                font-family: "Times New Roman", Times, serif;
                color: #333;
            }

            .stmt .hi {
                font-size: 14.5px;
                font-weight: 600;
            }

        /* ---------- course block ---------- */
        .course {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-top: 1.5mm;
            text-align: center;
        }

            .course .hi-course {
                font-size: 21px;
                font-weight: 700;
                color: #444;
                line-height: 1.3;
            }

            .course .hi-sub {
                font-size: 16px;
                font-weight: 700;
            }

            .course .hi-exam {
                font-size: 14.5px;
                font-weight: 600;
            }

            .course .en-course {
                font-size: 21px;
                font-weight: 700;
                color: #444;
                font-family: Arial, Helvetica, sans-serif;
                margin-top: 5px;
            }

            .course .en-sub {
                font-size: 17px;
                font-weight: 700;
                color: #666;
                font-family: Arial, Helvetica, sans-serif;
            }

            .course .en-exam {
                font-size: 14px;
                font-weight: 600;
                font-family: Arial, Helvetica, sans-serif;
            }

        /* ---------- student info ---------- */
        .stu {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 10px;
            margin-top: 0;
            font-size: 12px;
            line-height: 1.65;
        }

            .stu .left {
                padding-top: 3mm;
            }

                .stu .left b, .stu .right b {
                    font-weight: 600;
                }

            .stu .val {
                font-weight: 600;
                font-family: "Times New Roman", "Noto Serif Devanagari", serif;
            }

            .stu .right {
                padding-right: 2mm;
                white-space: nowrap;
            }

            .stu sup {
                font-size: 8px;
            }

        /* ---------- marks table (ek hi border + ek hi font poori table me) ---------- */
        table.marks {
            /* Table ko frame ke border se chipka diya (left + right), original jaisa */
            width: calc(100% + 10mm); /* 10mm = frame ka left + right padding (5mm + 5mm) */
            margin: 2mm -5mm 0 -5mm;
            border-collapse: collapse;
            font-family: Arial, "Noto Sans Devanagari", Helvetica, sans-serif;
            font-size: 12px;
            color: #000;
        }

            table.marks th, table.marks td {
                border: 1px solid #000;
                padding: 4px 5px;
                text-align: center;
                vertical-align: middle;
                font-family: inherit;
            }

            table.marks th {
                font-weight: 700;
                font-size: 12px;
                line-height: 1.4;
            }

            table.marks td.sub {
                text-align: left;
                font-weight: 700;
                font-size: 11.5px;
                line-height: 1.35;
                padding: 3px 5px;
            }

            table.marks td.num, table.marks td.tot {
                font-weight: 700;
                font-size: 12.5px;
            }

            table.marks tr.gt td {
                font-size: 13.5px;
                font-weight: 700;
                height: 8mm;
            }

                table.marks tr.gt td.gt-label {
                    text-align: right;
                    padding-right: 10px;
                    white-space: nowrap;
                }

            table.marks tr.summary td {
                text-align: left;
                font-weight: 700;
                font-size: 12px;
                vertical-align: top;
                height: 13mm;
            }

                table.marks tr.summary td .en {
                    display: block;
                    margin-top: 4px;
                }

        .result-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 1mm;
            font-size: 13px;
            font-weight: 700;
            padding-left: 8mm;
        }

            .result-row .res {
                font-size: 16px;
                font-weight: 700;
            }

                .result-row .res .en-serif {
                    font-size: 15px;
                }

        /* ---------- notes ---------- */
        .notes {
            margin-top: 1.5mm;
            font-size: 11.5px;
            line-height: 1.4;
        }

            .notes .item {
                display: grid;
                grid-template-columns: 5mm 1fr; /* number | text */
                align-items: start;
                margin-bottom: 3px;
            }

            .notes .no {
                font-weight: 500;
            }

            .notes .txt .hi {
                display: block;
                font-weight: 500;
            }

            .notes .txt .en {
                display: block;
                font-size: 10.5px;
                font-weight: 700;
                padding-left: 0;
                font-family: "Times New Roman", Times, serif;
            }

            .notes .txt .legend.hi,
            .notes .txt .legend.en {
                display: grid;
                grid-template-columns: 24mm 20mm 20mm auto; /* D | G | F | AB */
            }

            .notes .txt .legend.hi {
                font-weight: 500;
            }

            .notes .txt .legend.en {
                font-size: 10.5px;
                font-weight: 700;
                font-family: "Times New Roman", Times, serif;
            }
        /* ---------- footer ---------- */
        .spacer {
            flex: 1;
            min-height: 6mm;
        }

        .foot {
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            align-items: end;
            font-size: 12.5px;
            font-weight: 700;
        }

            .foot .left {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                padding-right: 10mm;
            }

                .foot .left .place {
                    line-height: 1.5;
                }

                    .foot .left .place .small {
                        font-size: 11px;
                        display: block;
                    }

            .foot .qr {
                width: 17mm;
                height: 17mm;
                background: #fff;
            }

                .foot .qr img, .foot .qr canvas {
                    width: 100% !important;
                    height: 100% !important;
                }

                .foot .qr canvas {
                    display: none !important;
                }

            .foot .right {
                text-align: center;
                margin-right: -22%;
                font-family: "Times New Roman", Times, serif;
            }

                .foot .right img {
                    height: 14mm;
                    display: block;
                    margin: 0 auto 3px;
                }

                .foot .right .coe-hi {
                    font-family: "Noto Serif Devanagari", serif;
                    font-size: 14px;
                }

                .foot .right .coe-en {
                    font-size: 14px;
                    letter-spacing: .4px;
                }

        /* ---------- PRINT: sab kuch ek hi A4 page par, border poora ---------- */
        @@media print {
            html, body {
                background: #fff;
                width: 210mm;
                height: 297mm;
            }

            .toolbar, .print-modal {
                display: none !important;
            }

            .serial-bottom {
                bottom: 2mm;
                right: 8mm;
            }

            .sheet-wrap {
                padding: 0;
                display: block;
            }

            .page {
                box-shadow: none;
                width: 210mm;
                height: 297mm;
                min-height: 0;
                padding: 7mm 8mm;
                overflow: hidden;
                page-break-after: avoid;
                page-break-inside: avoid;
                break-inside: avoid;
            }

            .frame {
                height: 283mm; /* 297 - 7 - 7 */
                min-height: 0;
                border: 1.5px solid #000;
                transform-origin: top left;
            }

            table.marks, table.marks tr, .notes, .foot {
                page-break-inside: avoid;
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>

    <div class="toolbar"><button type="button" onclick="openPrintPopup()">Print Marksheet / प्रिंट करें</button></div>

    <div class="sheet-wrap">
        <div class="page">
            <div class="frame">

                <!-- Serial / Folio -->
                <div class="meta-top">
                    <div>क्रम संख्या /Serial No.: <span id="serialNo"></span></div>
                    <div class="folio">फोलियो संख्या /Folio No.: <span id="folioNo"></span></div>
                </div>

                <!-- Header -->
                <div class="hdr">
                    <div class="hdr-left">
                        <div class="hi-main">राष्ट्रीय आयुर्वेद संस्थान</div>
                        <div class="hi-sub">मानद विश्वविद्यालय</div>
                        <div class="hi-small">(आयुष मंत्रालय, भारत सरकार)</div>
                        <div class="hi-addr">आमेर रोड, जयपुर-302002</div>
                    </div>
                    <div class="hdr-logo">
                        <img src="@Url.Content("~/Logo/nia_logo.png")" alt="NIA Logo"
                             onerror="this.style.display='none'; document.getElementById('logoFb').style.display='flex';">
                        <div class="logo-fallback" id="logoFb">NIA<br>LOGO</div>
                    </div>
                    <div class="hdr-right">
                        <div class="en-main">National Institute of Ayurveda</div>
                        <div class="en-sub">Deemed to be University</div>
                        <div class="en-small">(Ministry of AYUSH, Govt. of India)</div>
                        <div class="en-addr">Amer Road, Jaipur-302002</div>
                    </div>
                </div>

                <!-- Statement title -->
                <div class="stmt">
                    <div class="en" id="stmtEn"></div>
                    <div class="hi" id="stmtHi"></div>
                </div>

                <!-- Course block -->
                <div class="course">
                    <div>
                        <div class="hi-course" id="courseHi"></div>
                        <div class="hi-sub" id="specHi"></div>
                        <div class="hi-exam" id="examHi"></div>
                    </div>
                    <div>
                        <div class="en-course" id="courseEn"></div>
                        <div class="en-sub" id="specEn"></div>
                        <div class="en-exam" id="examEn"></div>
                    </div>
                </div>

                <!-- Student info -->
                <div class="stu">
                    <div class="left">
                        <div><b>नाम/Name:</b> <span class="val" id="nameBoth"></span></div>
                        <div><b>पिता का नाम/Father's Name:</b> <span class="val" id="fatherBoth"></span></div>
                        <div><b>माता का नाम/Mother's Name:</b> <span class="val" id="motherBoth"></span></div>
                    </div>
                    <div class="right">
                        <div><b>अनुक्रमांक / Roll No.:</b> <span class="val" id="rollNo"></span></div>
                        <div><b>नामांकन संख्या/Enrollment No.:</b><span class="val" id="enrollNo"></span></div>
                        <div><b>प्रयास / Attempt:</b> <span class="val" id="attempt"></span></div>
                    </div>
                </div>

                <!-- Marks table -->
                <table class="marks">
                    <colgroup>
                        <col style="width:33%">
                        <col style="width:9%">
                        <col style="width:8%">
                        <col style="width:10%">
                        <col style="width:11%">
                        <col style="width:10%">
                        <col style="width:10%">
                    </colgroup>
                    <thead>
                        <tr>
                            <th rowspan="2">विषय<br><span class="en">Subject (s)</span></th>
                            <th rowspan="2">अधिकतम<br>अंक<br><span class="en">Max.<br>Marks<br><span id="maxAll"></span></span></th>
                            <th rowspan="2">न्यूनतम<br>अंक<br><span class="en">Min<br>Marks<br><span id="minAll"></span></span></th>
                            <th colspan="3">प्राप्तांक<br><span class="en">Marks Obtained</span></th>
                            <th rowspan="2">टिप्पणी<br><span class="en">Remarks</span></th>
                        </tr>
                        <tr>
                            <th>सैद्धांतिक<br><span class="en">Theory</span></th>
                            <th>प्रायोगिक या<br>साक्षात्कार<br><span class="en">Practical /<br>Viva Voce</span></th>
                            <th>विषय योग<br><span class="en">Subject<br>Total</span></th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                    <tfoot>
                        <tr class="gt">
                            <td colspan="3" class="blank"></td>
                            <td colspan="2" class="gt-label">कुल योग / GRAND TOTAL</td>
                            <td class="tot" id="grandTotal"></td>
                            <td></td>
                        </tr>
                        <tr class="summary">
                            <td colspan="2">
                                डिस्टिंक्शन प्राप्ति: <span id="distHi"></span>
                                <span class="en">Distinction secured: <span id="distEn"></span></span>
                            </td>
                            <td colspan="3">
                                कृपांक प्राप्ति: <span id="graceHi"></span>
                                <span class="en">Grace Marks Awarded: <span id="graceEn"></span></span>
                            </td>
                            <td colspan="2">
                                अनुत्तीर्ण: <span id="failHi"></span>
                                <span class="en">Failed: <span id="failEn"></span></span>
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <!-- Note + result -->
                <div class="result-row">
                    <div>टिप्पणी:<br><span class="en-serif">Note:</span></div>
                    <div class="res">परिणाम / <span class="en-serif">RESULT:</span> <span id="resultText"></span></div>
                </div>

                <div class="notes">
                    <div class="item">
                        <span class="no">1.</span>
                        <div class="txt">
                        <span class="hi">एक विषय में उत्तीर्ण होने के लिए अभ्यर्थी को सैद्धांतिक और व्यावहारिक परीक्षा में से प्रत्येक में न्यूनतम 50% अंक प्राप्त करना आवश्यक है।</span>
                        <span class="en">For candidate to pass, he/she shall require to obtain a minimum of 50% marks in each of Theory and Practical examination.</span>
                        </div>
                    </div>
                    <div class="item">
                        <span class="no">2.</span>
                        <div class="txt">
                        <span class="hi"> किसी विषय में 75% या उससे अधिक अंक प्राप्त करने वाले अभ्यर्थी को उस विषय में डिस्टिंक्शन (D द्वारा चिन्हित) प्राप्त दिखाया जायेगा।</span>
                        <span class="en">The Candidate securing 75% marks or above in a Subject shall be declared to have obtained distinction (Denoted by D) in that Subject.</span>
                        </div>
                    </div>
                    <div class="item">
                        <span class="no">3.</span>
                        <div class="txt">
                        <span class="hi"> किसी पेपर के सैद्धांतिक भाग में अनुत्तीर्ण होने वाले अभ्यर्थी को सैद्धांतिक और व्यावहारिक परीक्षा दोनों में अनुत्तीर्ण माना जाएगा।</span>
                        <span class="en">A candidate failing in the Theory part of a paper will be considered fail in Theory and Practical both.</span>
                        </div>
                    </div>
                    <div class="item">
                        <span class="no">4.</span>
                        <div class="txt">
                        <span class="hi"> नियमों के तहत अनुमेय अंकों की जांच और/या उत्तर पुस्तिकाओं के पुनर्मूल्यांकन के लिए आवेदन आवश्यक शुल्क के साथ निर्धारित प्रपत्र में परिणाम की घोषणा की तारीख से 5 दिनों के भीतर रजिस्ट्रार के पास पहुंच जाना चाहिए।</span>
                        <span class="en">Application for scrutiny of marks and /or revaluation of answer-books as permissible under the rules should reach the Registrar on the prescribed form along with the requisite fees within the 5 days from the date of declaration of result.</span>
                        </div>
                    </div>
                    <div class="item">
                        <span class="no">5.</span>
                        <div class="txt">
                        <span class="hi">अंक - विवरणिका तैयार करने के दौरान यदि कोई त्रुटि हो जाती है और बाद में ध्यान में लाई जाती है, तो उसे ठीक करने का पूर्ण अधिकार विश्वविद्यालय के पास होगा।</span>
                        <span class="en">In case of any mistake occurred during the preparation of marks-statement brought to notice afterwards, the University will be fully empowered to correct the same.</span>
                        </div>
