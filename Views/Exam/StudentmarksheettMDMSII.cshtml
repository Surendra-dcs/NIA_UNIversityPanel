@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Marksheet";
    Layout = null;

    string apiBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "";
    string enrollment = Convert.ToString(ViewBag.enrollment) ?? "";
    string examId = Convert.ToString(ViewBag.examId) ?? "";
}
<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Statement of Marks</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Devanagari:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Tinos:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <script>
        var ApiBaseUrl       = @Json.Serialize(apiBaseUrl);
        var EnrollmentNumber = @Json.Serialize(enrollment);
        var ExamId           = @Json.Serialize(examId);
    </script>


    <style>
        /* =====================================================================
                           SELF-HOSTED FONTS  (wwwroot/fonts/marksheet/)
                           File na mile to browser apne aap Google Fonts / system font use karega.
                           ===================================================================== */
        @@font-face {
            font-family: "NIA Sans Devanagari";
            font-weight: 400;
            font-display: swap;
            src: url('@Url.Content("~/fonts/marksheet/noto-sans-devanagari-devanagari-400-normal.woff2")') format('woff2');
            unicode-range: U+0900-097F, U+1CD0-1CF9, U+200C-200D, U+20A8, U+20B9, U+20F0, U+25CC, U+A830-A839, U+A8E0-A8FF;
        }

        @@font-face {
            font-family: "NIA Sans Devanagari";
            font-weight: 600;
            font-display: swap;
            src: url('@Url.Content("~/fonts/marksheet/noto-sans-devanagari-devanagari-600-normal.woff2")') format('woff2');
            unicode-range: U+0900-097F, U+1CD0-1CF9, U+200C-200D, U+20A8, U+20B9, U+20F0, U+25CC, U+A830-A839, U+A8E0-A8FF;
        }

        @@font-face {
            font-family: "NIA Sans Devanagari";
            font-weight: 700;
            font-display: swap;
            src: url('@Url.Content("~/fonts/marksheet/noto-sans-devanagari-devanagari-700-normal.woff2")') format('woff2');
            unicode-range: U+0900-097F, U+1CD0-1CF9, U+200C-200D, U+20A8, U+20B9, U+20F0, U+25CC, U+A830-A839, U+A8E0-A8FF;
        }

        @@font-face {
            font-family: "NIA Tinos";
            font-weight: 400;
            font-display: swap;
            src: url('@Url.Content("~/fonts/marksheet/tinos-latin-400-normal.woff2")') format('woff2');
            unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
        }

        @@font-face {
            font-family: "NIA Tinos";
            font-weight: 700;
            font-display: swap;
            src: url('@Url.Content("~/fonts/marksheet/tinos-latin-700-normal.woff2")') format('woff2');
            unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
        }

        /* =====================================================================
                           FONT SYSTEM  (photo wali marksheet jaisa)
                           Hindi            : Devanagari sans (Mangal / Nirmala jaisa)
                           English serif    : Times  (statement, naam, result, notes, footer)
                           English sans     : Calibri (header sub-lines, course, table)
                           ===================================================================== */
        :root {
            --hi: "NIA Sans Devanagari", "Noto Sans Devanagari", "Nirmala UI", "Mangal", sans-serif;
            --serif: "NIA Tinos", "Tinos", "Times New Roman", Times, serif;
            --sans: Calibri, Carlito, Arial, Helvetica, sans-serif;
            /* mixed line: English Times me, Hindi Devanagari font me */
            --serif-mix: "NIA Tinos", "Tinos", "Times New Roman", Times, "NIA Sans Devanagari", "Noto Sans Devanagari", "Nirmala UI", "Mangal", serif;
            --sans-mix: Calibri, Carlito, Arial, "NIA Sans Devanagari", "Noto Sans Devanagari", "Nirmala UI", "Mangal", sans-serif;
        }

        @@page {
            size: A4 portrait;
            margin: 0;
        }

        * {
            box-sizing: border-box;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        html, body {
            margin: 0;
            padding: 0;
            background: #cfd4da;
        }

        body {
            font-family: var(--serif-mix);
            color: #000;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }

        .en-serif {
            font-family: var(--serif);
        }

        .en-sans {
            font-family: var(--sans);
        }

        /* ---------- toolbar (screen only) ---------- */
        .toolbar {
            position: sticky;
            top: 0;
            z-index: 10;
            padding: 10px;
            text-align: center;
            background: rgba(207, 212, 218, .92);
            backdrop-filter: blur(4px);
        }

            .toolbar button {
                background: #1f3a68;
                color: #fff;
                border: none;
                border-radius: 4px;
                padding: 9px 26px;
                font-size: 14px;
                font-weight: 600;
                letter-spacing: .3px;
                cursor: pointer;
                font-family: Arial, var(--hi);
                box-shadow: 0 2px 6px rgba(0,0,0,.18);
            }

                .toolbar button:hover {
                    background: #162b4f;
                }

        /* ---------- A4 page ---------- */
        .sheet-wrap {
            padding: 18px 0 40px;
            display: flex;
            justify-content: center;
        }

        .page {
            width: 210mm;
            min-height: 297mm;
            background: #fff;
            padding: 12mm 12mm;
            box-shadow: 0 10px 34px rgba(0,0,0,.28);
            position: relative;
        }

        /* ---------- bottom serial (frame ke neeche, right side) ---------- */
        .serial-bottom {
            position: absolute;
            right: 8mm;
            bottom: 4mm;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .4px;
            font-family: Arial, Helvetica, sans-serif;
        }

        /* ---------- grace subject: poori row yellow ---------- */
        table.marks tr.grace-row > td {
            background: yellow !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* ---------- PRINT POPUP (Serial / Folio / Bottom Serial) ---------- */
        .print-modal {
            display: none;
            position: fixed;
            z-index: 99999;
            inset: 0;
            background: rgba(0, 0, 0, 0.55);
            align-items: center;
            justify-content: center;
            font-family: Arial, Helvetica, sans-serif;
        }

        .print-modal-content {
            width: 420px;
            max-width: 90%;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            animation: printModalOpen 0.2s ease;
        }

        @@keyframes printModalOpen {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .print-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 20px;
            border-bottom: 1px solid #ddd;
        }

            .print-modal-header h3 {
                margin: 0;
                font-size: 19px;
                font-weight: 600;
            }

        .print-modal-close {
            border: none;
            background: transparent;
            font-size: 27px;
            line-height: 1;
            cursor: pointer;
            color: #666;
        }

            .print-modal-close:hover {
                color: #000;
            }

        .print-modal-body {
            padding: 20px;
        }

        .print-input-group {
            margin-bottom: 16px;
        }

            .print-input-group label {
                display: block;
                margin-bottom: 6px;
                font-size: 14px;
                font-weight: 600;
                color: #333;
            }

        .print-input {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            outline: none;
        }

            .print-input:focus {
                border-color: #1f3a68;
            }

        .print-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 15px 20px;
            border-top: 1px solid #ddd;
            background: #fafafa;
        }

        .print-cancel-btn, .print-save-btn {
            padding: 9px 16px;
            border-radius: 5px;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }

        .print-cancel-btn {
            background: #e5e5e5;
            color: #333;
        }

        .print-save-btn {
            background: #1f3a68;
            color: #fff;
        }

            .print-save-btn:hover {
                background: #162b4f;
            }

        /* =====================================================================
                           OUTER FRAME : bahar 3px + andar 1px
                           Frame hamesha A4 ke andar ki poori height leta hai (272mm =
                           297 - 12 top - 12 bottom padding - 1mm safety).
                           Subjects kam hon to bachi jagah TABLE ki rows me + footer se pehle
                           baant di jaati hai -> page par khali jagah nahi dikhti.
                           Subjects zyada hon to purana fitForPrint() JS page ko fit kar deta hai.
                           ===================================================================== */
        .frame {
            border: 1px solid #000;
            outline: 3px solid #000;
            outline-offset: 2px;
            padding: 3mm 5mm 3mm;
            min-height: 272mm;
            display: flex;
            flex-direction: column;
        }

        /* ---------- serial / folio ---------- */
        .meta-top {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            font-family: var(--serif-mix);
            font-size: 13px;
            font-weight: 700;
            line-height: 1.25;
        }

            .meta-top span {
                font-family: var(--serif);
                font-size: 14px;
                font-weight: 700;
                padding-left: 2px;
            }

        /* =====================================================================
                           TOP : header  (Hindi | Logo | English)
                           ===================================================================== */
        .hdr {
            display: grid;
            grid-template-columns: 1fr 22mm 1.13fr;
            align-items: center;
            gap: 1.5mm;
            margin-top: 2mm;
        }

        .hdr-left, .hdr-right {
            text-align: center;
            white-space: nowrap;
        }

            /* line 1 : institute name (photo jaisa grey) */
            .hdr-left .hi-main, .hdr-right .en-main {
                height: 34px;
                line-height: 34px;
                color: #4d4d4d;
            }

            .hdr-left .hi-main {
                font-family: var(--hi);
                font-size: 27px;
                font-weight: 600;
            }

            .hdr-right .en-main {
                font-family: var(--serif);
                font-size: 21px;
                font-weight: 700;
                letter-spacing: 0;
            }

            /* line 2 : deemed university */
            .hdr-left .hi-sub, .hdr-right .en-sub {
                height: 23px;
                line-height: 22px;
                color: #1a1a1a;
            }

            .hdr-left .hi-sub {
                font-family: var(--hi);
                font-size: 16px;
                font-weight: 600;
            }

            .hdr-right .en-sub {
                font-family: var(--sans);
                font-size: 16px;
                font-weight: 600;
            }

            /* line 3 : ministry (halka grey) */
            .hdr-left .hi-small, .hdr-right .en-small {
                height: 20px;
                line-height: 20px;
                color: #92a4c9;
            }

            .hdr-left .hi-small {
                font-family: var(--hi);
                font-size: 13.5px;
                font-weight: 600;
            }

            .hdr-right .en-small {
                font-family: var(--sans);
                font-size: 15px;
                font-weight: 700;
            }

            /* line 4 : address */
            .hdr-left .hi-addr, .hdr-right .en-addr {
                height: 21px;
                line-height: 21px;
                color: #1a1a1a;
            }

            .hdr-left .hi-addr {
                font-family: var(--hi);
                font-size: 16px;
                font-weight: 600;
            }

            .hdr-right .en-addr {
                font-family: var(--sans);
                font-size: 16px;
                font-weight: 600;
            }

        .hdr-logo {
            text-align: center;
            line-height: 0;
        }

            .hdr-logo img {
                width: 22mm;
                height: 22mm;
                object-fit: contain;
            }

        .logo-fallback {
            width: 21mm;
            height: 21mm;
            border: 2px solid #777;
            border-radius: 50%;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            line-height: 1.3;
            color: #777;
            text-align: center;
            margin: 0 auto;
        }

        /* =====================================================================
                           MIDDLE : statement title (English 1 line + Hindi 1 line) + course
                           ===================================================================== */
        .stmt {
            text-align: center;
            margin: 2.5mm -4.5mm 0; /* thodi extra chaudai -> title hamesha ek line */
            white-space: nowrap;
            margin-top: 3mm;
        }

            .stmt .en {
                font-family: var(--serif);
                font-size: 16px;
                font-weight: 700;
                line-height: 21px;
            }

            .stmt .hi {
                font-family: var(--hi);
                font-size: 16px;
                font-weight: 700;
                line-height: 25px;
            }

        .course {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4mm;
            margin-top: 1mm;
            text-align: center;
            white-space: nowrap;
        }

            .course .hi-course, .course .en-course {
                height: 29px;
                line-height: 29px;
                font-weight: 700;
            }

            .course .hi-course {
                font-family: var(--hi);
                font-size: 21px;
                color: #1a1a1a;
            }

            .course .en-course {
                font-family: var(--sans);
                font-size: 22.5px;
                color: #333;
            }

            .course .hi-sub, .course .en-sub {
                height: 25px;
                line-height: 25px;
                font-weight: 700;
            }

            .course .hi-sub {
                font-family: var(--hi);
                font-size: 20px;
                color: #1a1a1a;
            }

            .course .en-sub {
                font-family: var(--sans);
                font-size: 21.5px;
                color: #444;
            }

            .course .hi-exam, .course .en-exam {
                height: 21px;
                line-height: 21px;
                font-weight: 700;
            }

            .course .hi-exam {
                font-family: var(--hi);
                font-size: 14px;
            }

            .course .en-exam {
                font-family: var(--sans);
                font-size: 15px;
            }

        /* =====================================================================
                           BOTTOM : student info
                           ===================================================================== */
        .stu {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 3mm;
            margin-top: 1.5mm;
            font-family: var(--serif-mix);
            font-size: 13.5px;
        }

            /* har row 19px; lamba naam ho to neat tareeke se agli line me wrap */
            .stu .left > div, .stu .right > div {
                min-height: 19px;
                line-height: 17.5px;
                padding: .75px 0;
            }

            .stu .right > div {
                white-space: nowrap;
            }

            .stu .left b, .stu .right b {
                font-size: 13px;
                font-weight: 700;
            }

            .stu .val {
                font-family: var(--serif-mix);
                font-size: 14px;
                font-weight: 700;
            }

            .stu #enrollNo {
                margin-left: .3em;
            }

            .stu .right {
                padding-right: 1mm;
            }

            .stu sup {
                font-size: 10px;
                line-height: 0;
            }

            .stu .hi-name {
                font-family: var(--hi);
                font-size: 14.5px;
                font-weight: 700;
            }

            .stu .en-name {
                font-family: var(--serif);
                font-size: 14px;
                font-weight: 700;
            }

        /* =====================================================================
                           MARKS TABLE
                           flex-grow: page par bachi hui jagah subject rows me chali jaati hai,
                           isliye subjects kam hon to rows thodi oonchi ho jaati hain.
                           ===================================================================== */
        table.marks {
            /* frame ke left/right border se chipki (ek hi line dikhti hai) */
            width: calc(100% + 10mm + 2px);
            margin: 2mm calc(-5mm - 1px) 0;
            flex: 3 0 auto;
            position: relative;
            background: #fff;
            border-collapse: collapse;
            table-layout: fixed;
            font-family: var(--sans-mix);
            font-size: 13.5px;
            font-variant-numeric: tabular-nums;
        }

            table.marks col:nth-child(1) {
                width: 44% !important;
            }

            table.marks col:nth-child(2) {
                width: 8% !important;
            }

            table.marks col:nth-child(3) {
                width: 8% !important;
            }

            table.marks col:nth-child(4) {
                width: 10% !important;
            }

            table.marks col:nth-child(5) {
                width: 12% !important;
            }

            table.marks col:nth-child(6) {
                width: 9% !important;
            }

            table.marks col:nth-child(7) {
                width: 9% !important;
            }

            table.marks th, table.marks td {
                border: 1px solid #000;
                padding: 4px 5px;
                text-align: center;
                vertical-align: middle;
                font-family: inherit;
            }

            table.marks th {
                font-family: var(--hi);
                font-weight: 700;
                font-size: 11.6px;
                line-height: 1.15;
                padding: 1px 2px;
            }

                table.marks th .en {
                    font-family: var(--sans);
                    font-weight: 700;
                    font-size: 12px;
                }

            table.marks td.sub {
                text-align: left;
                line-height: 1.12;
                padding: 1px 2px;
            }

                table.marks td.sub .hi {
                    font-family: var(--hi);
                    font-weight: 700;
                    font-size: 12px;
                    line-height: 1.25;
                }

                table.marks td.sub .en {
                    font-family: var(--sans);
                    font-weight: 700;
                    font-size: 12.5px;
                }

            table.marks td.num, table.marks td.tot {
                font-family: var(--sans);
                font-weight: 700;
                font-size: 14.5px;
            }

            table.marks tbody tr > td {
                height: 7.2mm; /* minimum; jagah bache to apne aap badhti hai */
            }

            table.marks tr.gt td {
                font-weight: 700;
                height: 6.5mm;
            }

                table.marks tr.gt td.gt-label {
                    font-family: var(--sans-mix);
                    font-size: 14px;
                    text-align: right;
                    padding-right: 6px;
                    white-space: nowrap;
                }

                table.marks tr.gt td.tot {
                    font-size: 16px;
                }

            table.marks tr.summary td {
                font-family: var(--sans-mix);
                text-align: left;
                font-weight: 700;
                font-size: 12.5px;
                line-height: 1.22;
                vertical-align: top;
                height: 8.5mm;
                padding: 2px 7px;
            }

                table.marks tr.summary td .en {
                    display: block;
                    margin-top: 1px;
                    font-size: 12.5px;
                }

        /* ---------- note heading + result ---------- */
        .result-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 1.2mm;
            margin-bottom: 1mm;
            padding-left: 6mm;
            font-family: var(--serif-mix);
            font-size: 14px;
            font-weight: 700;
            line-height: 1.2;
        }

            .result-row .res {
                font-size: 18px;
                font-weight: 700;
                padding-right: 1mm;
            }

                .result-row .res .en-serif {
                    font-size: 18px;
                }

        /* ---------- notes ---------- */
        .notes {
            margin-top: 1mm;
            font-family: var(--hi);
            font-size: 10px;
            line-height: 1.22;
        }

            .notes .item {
                display: grid;
                grid-template-columns: 6mm 1fr; /* number | text */
                align-items: start;
                margin-bottom: 1px;
            }

            .notes .no {
                font-family: var(--hi);
                font-size: 10px;
                font-weight: 600;
                line-height: 1.22;
            }

            .notes .txt .hi {
                display: block;
                font-weight: 600;
            }

            .notes .txt .en {
                display: block;
                font-family: var(--serif);
                font-size: 9px;
                font-weight: 700;
                line-height: 1.12;
            }

            .notes .txt .legend.hi,
            .notes .txt .legend.en {
                display: grid;
                grid-template-columns: 27mm 22mm 22mm auto; /* D | G | F | AB */
            }

            .notes .txt .legend.hi {
                font-weight: 600;
            }

            .notes .txt .legend.en {
                font-family: var(--serif);
                font-size: 9px;
                font-weight: 700;
            }

        /* ---------- footer ---------- */
        .spacer {
            flex: 1 0 3mm; /* bachi jagah ka chhota hissa footer se pehle */
        }

        .foot {
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            align-items: end;
            font-family: var(--serif-mix);
            font-size: 13.5px;
            font-weight: 700;
        }

            .foot .left {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                padding-right: 10mm;
            }

                .foot .left .place {
                    line-height: 1.28;
                }

                    .foot .left .place .small {
                        font-size: 12.5px;
                        display: block;
                    }

                    .foot .left .place #resultDate {
                        font-family: var(--serif);
                        font-size: 13px;
                    }

            .foot .qr {
                width: 17mm;
                height: 17mm;
                background: #fff;
            }

                .foot .qr img, .foot .qr canvas {
                    width: 100% !important;
                    height: 100% !important;
                }

                .foot .qr canvas {
                    display: none !important;
                }

            .foot .right {
                text-align: center;
                margin-right: -22%;
                line-height: 1.25;
            }

                .foot .right img {
                    height: 10mm;
                    display: block;
                    margin: 0 auto 3px;
                }

                .foot .right .coe-hi {
                    font-family: var(--hi);
                    font-size: 14px;
                    font-weight: 600;
                }

                .foot .right .coe-en {
                    font-family: var(--serif);
                    font-size: 13px;
                    font-weight: 700;
                    letter-spacing: .5px;
                    color: #222;
                }

        /* =====================================================================
                           PRINT : exact A4 (210 x 297mm), ek hi page, koi khali jagah nahi
                           ===================================================================== */
        @@media print {
            /* 297mm se 1mm kam: printer/rounding ki wajah se khali 2nd page nahi banega */
            html, body {
                background: #fff;
                width: 210mm;
                height: 296mm;
                overflow: hidden;
            }

            .toolbar, .print-modal {
                display: none !important;
            }

            .sheet-wrap {
                padding: 0;
                display: block;
            }

            .page {
                box-shadow: none;
                width: 210mm;
                height: 296mm;
                min-height: 0;
                padding: 12mm 12mm;
                overflow: hidden;
                page-break-after: avoid;
                page-break-inside: avoid;
                break-inside: avoid;
            }

            .frame {
                height: 272mm; /* 296 - 12 - 12 (page padding) */
                min-height: 0;
                transform-origin: top left;
            }

            table.marks, table.marks tr, .notes, .foot {
                page-break-inside: avoid;
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>

    <div class="toolbar"><button type="button" onclick="openPrintPopup()">Print Marksheet / प्रिंट करें</button></div>

    <div class="sheet-wrap">
        <div class="page">
            <div class="frame">

                <!-- Serial / Folio -->
                <div class="meta-top">
                    <div>क्रम संख्या /Serial No.: <span id="serialNo"></span></div>
                    <div class="folio">फोलियो संख्या /Folio No.: <span id="folioNo"></span></div>
                </div>

                <!-- Header -->
                <div class="hdr">
                    <div class="hdr-left">
                        <div class="hi-main">राष्ट्रीय आयुर्वेद संस्थान</div>
                        <div class="hi-sub">मानद विश्वविद्यालय</div>
                        <div class="hi-small">(आयुष मंत्रालय, भारत सरकार)</div>
                        <div class="hi-addr">आमेर रोड, जयपुर-302002</div>
                    </div>
                    <div class="hdr-logo">
                        <img src="@Url.Content("~/Logo/nia_logo.png")" alt="NIA Logo"
                             onerror="this.style.display='none'; document.getElementById('logoFb').style.display='flex';">
                        <div class="logo-fallback" id="logoFb">NIA<br>LOGO</div>
                    </div>
                    <div class="hdr-right">
                        <div class="en-main">National Institute of Ayurveda</div>
                        <div class="en-sub">Deemed to be University</div>
                        <div class="en-small">(Ministry of AYUSH, Govt. of India)</div>
                        <div class="en-addr">Amer Road, Jaipur-302002</div>
                    </div>
                </div>

                <!-- Statement title -->
                <div class="stmt">
                    <div class="en" id="stmtEn"></div>
                    <div class="hi" id="stmtHi"></div>
                </div>

                <!-- Course block -->
                <div class="course">
                    <div>
                        <div class="hi-course" id="courseHi"></div>
                        <div class="hi-sub" id="specHi"></div>
                        <div class="hi-exam" id="examHi"></div>
                    </div>
                    <div>
                        <div class="en-course" id="courseEn"></div>
                        <div class="en-sub" id="specEn"></div>
                        <div class="en-exam" id="examEn"></div>
                    </div>
                </div>

                <!-- Student info -->
                <div class="stu">
                    <div class="left">
                        <div><b>नाम/Name:</b> <span class="val" id="nameBoth"></span></div>
                        <div><b>पिता का नाम/Father's Name:</b> <span class="val" id="fatherBoth"></span></div>
                        <div><b>माता का नाम/Mother's Name:</b> <span class="val" id="motherBoth"></span></div>
                    </div>
                    <div class="right">
                        <div><b>अनुक्रमांक / Roll No.:</b> <span class="val" id="rollNo"></span></div>
                        <div><b>नामांकन संख्या/Enrollment No.:</b><span class="val" id="enrollNo"></span></div>
                        <div><b>प्रयास / Attempt:</b> <span class="val" id="attempt"></span></div>
                    </div>
                </div>

                <!-- Marks table -->
                <table class="marks">
                    <colgroup>
                        <col style="width:33%">
                        <col style="width:9%">
                        <col style="width:8%">
                        <col style="width:10%">
                        <col style="width:11%">
                        <col style="width:10%">
                        <col style="width:10%">
                    </colgroup>
                    <thead>
                        <tr>
                            <th rowspan="2">विषय<br><span class="en">Subject (s)</span></th>
                            <th rowspan="2">अधिकतम<br>अंक<br><span class="en">Max.<br>Marks<br><span id="maxAll"></span></span></th>
                            <th rowspan="2">न्यूनतम<br>अंक<br><span class="en">Min<br>Marks<br><span id="minAll"></span></span></th>
                            <th colspan="3">प्राप्तांक<br><span class="en">Marks Obtained</span></th>
                            <th rowspan="2">टिप्पणी<br><span class="en">Remarks</span></th>
                        </tr>
                        <tr>
                            <th>सैद्धांतिक<br><span class="en">Theory</span></th>
                            <th>प्रायोगिक या<br>साक्षात्कार<br><span class="en">Practical /<br>Viva Voce</span></th>
                            <th>विषय योग<br><span class="en">Subject<br>Total</span></th>
                        </tr>
                    </thead>
                    <tbody id="rows"></tbody>
                    <tfoot>
                        <tr class="gt">
                            <td colspan="3" class="blank"></td>
                            <td colspan="2" class="gt-label">कुल योग / GRAND TOTAL</td>
                            <td class="tot" id="grandTotal"></td>
                            <td></td>
                        </tr>
                        <tr class="summary">
                            <td colspan="2">
                                डिस्टिंक्शन प्राप्ति: <span id="distHi"></span>
                                <span class="en">Distinction secured: <span id="distEn"></span></span>
                            </td>
                            <td colspan="3">
                                कृपांक प्राप्ति: <span id="graceHi"></span>
                                <span class="en">Grace Marks Awarded: <span id="graceEn"></span></span>
                            </td>
                            <td colspan="2">
                                अनुत्तीर्ण: <span id="failHi"></span>
                                <span class="en">Failed: <span id="failEn"></span></span>
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <!-- Note + result -->
                <div class="result-row">
                    <div>टिप्पणी:<br><span class="en-serif">Note:</span></div>
                    <div class="res">परिणाम / <span class="en-serif">RESULT:</span> <span id="resultText"></span></div>
                </div>

                <div class="notes">
                    <div class="item">
                        <span class="no">1.</span>
                        <div class="txt">
                            <span class="hi">एक विषय में उत्तीर्ण होने के लिए अभ्यर्थी को सैद्धांतिक और व्यावहारिक परीक्षा में से प्रत्येक में न्यूनतम 50% अंक प्राप्त करना आवश्यक है।</span>
                            <span class="en">For candidate to pass, he/she shall require to obtain a minimum of 50% marks in each of Theory and Practical examination.</span>
                        </div>
                    </div>
                    <div class="item">
                        <span class="no">2.</span>
                        <div class="txt">
                            <span class="hi"> किसी विषय में 75% या उससे अधिक अंक प्राप्त करने वाले अभ्यर्थी को उस विषय में डिस्टिंक्शन (D द्वारा चिन्हित) प्राप्त दिखाया जायेगा।</span>
                            <span class="en">The Candidate securing 75% marks or above in a Subject shall be declared to have obtained distinction (Denoted by D) in that Subject.</span>
                        </div>
                    </div>
                    <div class="item">
                        <span class="no">3.</span>
                        <div class="txt">
                            <span class="hi"> किसी पेपर के सैद्धांतिक भाग में अनुत्तीर्ण होने वाले अभ्यर्थी को सैद्धांतिक और व्यावहारिक परीक्षा दोनों में अनुत्तीर्ण माना जाएगा।</span>
                            <span class="en">A candidate failing in the Theory part of a paper will be considered fail in Theory and Practical both.</span>
                        </div>
                    </div>
                    <div class="item">
                        <span class="no">4.</span>
                        <div class="txt">
                            <span class="hi"> नियमों के तहत अनुमेय अंकों की जांच और/या उत्तर पुस्तिकाओं के पुनर्मूल्यांकन के लिए आवेदन आवश्यक शुल्क के साथ निर्धारित प्रपत्र में परिणाम की घोषणा की तारीख से 5 दिनों के भीतर रजिस्ट्रार के पास पहुंच जाना चाहिए।</span>
                            <span class="en">Application for scrutiny of marks and /or revaluation of answer-books as permissible under the rules should reach the Registrar on the prescribed form along with the requisite fees within the 5 days from the date of declaration of result.</span>
                        </div>
                    </div>
                    <div class="item">
                        <span class="no">5.</span>
                        <div class="txt">
                            <span class="hi">अंक - विवरणिका तैयार करने के दौरान यदि कोई त्रुटि हो जाती है और बाद में ध्यान में लाई जाती है, तो उसे ठीक करने का पूर्ण अधिकार विश्वविद्यालय के पास होगा।</span>
                            <span class="en">In case of any mistake occurred during the preparation of marks-statement brought to notice afterwards, the University will be fully empowered to correct the same.</span>
                        </div>
                    </div>
                    <div class="item">
                        <span class="no">6.</span>
                        <div class="txt">
                            <div class="legend hi"><span>D-डिस्टिंक्शन</span><span>G- कृपांक</span><span>F-अनुत्तीर्ण</span><span>AB-अनुपस्थित</span></div>
                            <div class="legend en"><span>D-Distinction</span><span>G-Grace</span><span>F-Fail</span><span>Ab-Absent</span></div>
                        </div>
                    </div>
                </div>

                <div class="spacer"></div>

                <!-- Footer -->
                <div class="foot">
                    <div class="left">
                        <div class="place">
                            जयपुर<br>
                            <span class="en-serif">Jaipur</span>
                            <span class="small">परिणाम घोषित दिनांक</span>
                            <span class="small"> Result Date: <span id="resultDate"></span></span>
                        </div>
                        <div class="qr" id="qr"></div>
                    </div>
                    <div class="right">
                        <img src="@Url.Content("~/images/sig_coe.png")" alt="" onerror="this.style.display='none'">
                        <div class="coe-hi">परीक्षा नियंत्रक</div>
                        <div class="coe-en">CONTROLLER OF EXAMINATIONS</div>
                    </div>
                </div>

            </div>

            <!-- Bottom Serial (frame ke neeche) -->
            <div class="serial-bottom" id="serialbottom"></div>
        </div>
    </div>

    <!-- =================== PRINT POPUP =================== -->
    <div id="printModal" class="print-modal">
        <div class="print-modal-content">

            <div class="print-modal-header">
                <h3>Print Marksheet</h3>
                <button type="button" class="print-modal-close" onclick="closePrintPopup()">&times;</button>
            </div>

            <div class="print-modal-body">
                <div class="print-input-group">
                    <label for="printSerialNo">Serial No.</label>
                    <input type="text" id="printSerialNo" class="print-input" placeholder="Enter Serial No.">
                </div>

                <div class="print-input-group">
                    <label for="printFolioNo">Folio No.</label>
                    <input type="text" id="printFolioNo" class="print-input" placeholder="Enter Folio No.">
                </div>

                <div class="print-input-group">
                    <label for="printBottomSerial">Bottom Serial No.</label>
                    <input type="text" id="printBottomSerial" class="print-input" placeholder="Enter Bottom Serial No.">
                </div>
            </div>

            <div class="print-modal-footer">
                <button type="button" class="print-cancel-btn" onclick="closePrintPopup()">Cancel</button>
                <button type="button" class="print-save-btn" onclick="saveAndPrint()">Save &amp; Print</button>
            </div>

        </div>
    </div>

    <script>
        // =====================================================
        // CONFIG
        // =====================================================
        const VERIFY_URL = 'https://nia.edu.in/resultverification.php?uuid=';

        // =====================================================
        // FIELD MAPPING  (SP column names - case-insensitive)
        // Column ka naam alag ho to yahan array me add kar dijiye.
        // =====================================================
        const F = {
            serialNo:   ['SerialNo', 'Serialno', 'SNo'],
            folioNo:    ['Folio', 'FolioNo', 'UniqueCode'],
            serialBottom: ['SerialBottom', 'BottomSerialNo', 'BottomSerial'],
            uuid:       ['UUID', 'Uuid', 'ResultUUID', 'ResultGuid', 'VerificationId', 'GuidId'],

            // Poori exam line, e.g. "M.D. (Ay.) Agada Tantra Part-II Odd BATCH-2022 MAIN EXAM (September 2026)"
            // -> isi se Course / Specialization / Part / Month-Year nikale jaate hain
            examFull:   ['Examname', 'ExamFullName'],
            session:    ['ExaminationName', 'ExamSession'],                     // "September (2026)"

            // Neeche wale SP se aaye to wahi use honge, warna Examname se ban jaayenge
            stmtEn:     ['StatementEn', 'StatementTitle'],
            stmtHi:     ['StatementHi', 'StatementTitleHindi'],
            courseEn:   ['CourseName', 'CourseNameEn'],
            courseHi:   ['CourseHindiName', 'CourseNameHindi', 'ExamnameHindi'],
            // Specialization:  English -> SubjectNameCourseWise,  Hindi -> SubjectHindiNameCourseWise
            specEn:     ['SubjectNameCourseWise'],
            specHi:     ['SubjectHindiNameCourseWise'],
            heldOn:     ['ExamHeld', 'ExamHeldOn', 'ExamMonthYear'],

            nameHi:     ['CondidateHindi', 'CandidateHindi', 'CandidateHindiName'],
            nameEn:     ['CandidateName'],
            fatherHi:   ['FatherHindiName'],
            fatherEn:   ['FatherName'],
            motherHi:   ['MotherHindiName'],
            motherEn:   ['MotherName'],
            rollNo:     ['RollNumber', 'RollNo'],
            enrollNo:   ['EnrollmentNumber', 'EnrollmentNo'],
            attempt:    ['Attempt'],
            resultDate: ['Declaredate', 'ResultDate'],
            result:     ['Result'],
            grandTotal: ['GrandTotal'],

            // ---- per subject row ----
            paperEn:    ['PaperName', 'SubjectName', 'SubjectAppearing'],
            paperHi:    ['PaperHindiName', 'SubjectHindiName', 'SubjectNameHindi', 'SubjectHindiAppearing'],
            codeEn:     ['SubjectCodeType', 'SubjectCode'],
            codeHi:     ['SubjectHindiCodeType', 'SubjectHindiCode'],
            theory:     ['TheoryObtained'],
            practical:  ['PracticalObtained'],
            theoryMax:  ['TheoryMax'],
            practMax:   ['PracticalMax'],
            theoryMin:  ['TheoryMin'],
            practMin:   ['PracticalMin'],
            maxTotal:   ['MarksSchemeTotal', 'MaxMarks'],
            minTotal:   ['MarksSchemeMin', 'MinMarks'],
            total:      ['ObtainedTotal', 'SubjectTotal'],
            distinction:['Distinction'],
            grace:      ['GraceMarks'],
            remark:     ['Remarks', 'Remark']
        };

        // =====================================================
        // HELPERS
        // =====================================================
        const isBlank = v => v === null || v === undefined || String(v).trim() === '';

        // Column naam match: case, space, underscore sab ignore
        // "SubjectHindiNameCourseWise" = "subjectHindiNameCourseWise" = "Subject_Hindi_Name_CourseWise "
        const normKey = k => String(k).toLowerCase().replace(/[^a-z0-9]/g, '');

        function pick(obj, keys) {
            if (!obj) return '';
            const norm = {};
            Object.keys(obj).forEach(k => { norm[normKey(k)] = obj[k]; });
            for (const k of keys) {
                const v = (k in obj) ? obj[k] : norm[normKey(k)];
                if (!isBlank(v)) return String(v).trim();
            }
            return '';
        }

        // Saari rows me dhundo - jo pehli row me value mile wahi
        function pickAny(rows, keys) {
            for (const r of rows) {
                const v = pick(r, keys);
                if (v) return v;
            }
            return '';
        }

        function setText(id, value) {
            const el = document.getElementById(id);
            if (el) el.textContent = isBlank(value) ? '' : value;
        }

        function setHtml(id, html) {
            const el = document.getElementById(id);
            if (el) el.innerHTML = html;
        }

        function esc(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function num(value) {
            if (isBlank(value)) return 0;
            const n = Number(value);
            return Number.isFinite(n) ? n : 0;
        }

        const isAbsent = v => /^(AB|ABS|ABSENT)$/i.test(String(v ?? '').trim());

        function formatDate(value) {
            if (!value) return '';
            const d = new Date(value);
            if (isNaN(d.getTime())) return value;
            return `${String(d.getDate()).padStart(2, '0')}-${String(d.getMonth() + 1).padStart(2, '0')}-${d.getFullYear()}`;
        }

        const EN_MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
        const HI_MONTHS = {
            january:'जनवरी', february:'फरवरी', march:'मार्च', april:'अप्रैल', may:'मई', june:'जून',
            july:'जुलाई', august:'अगस्त', september:'सितम्बर', october:'अक्टूबर', november:'नवम्बर', december:'दिसम्बर'
        };

        function heldText(v) {
            if (isBlank(v)) return '';
            if (/^\d{4}-\d{2}/.test(v)) {
                const d = new Date(v);
                if (!isNaN(d.getTime())) return `${EN_MONTHS[d.getMonth()]} ${d.getFullYear()}`;
            }
            return v;
        }
        const toHindiMonth = s => String(s).replace(/[A-Za-z]+/g, w => HI_MONTHS[w.toLowerCase()] || w);

        // =====================================================
        // EXAM NAME PARSER
        // "M.D. (Ay.) Agada Tantra Part-II Odd BATCH-2022 MAIN EXAM (September 2026)"
        //   -> degree MD, spec "Agada Tantra", part II, month September, year 2026
        // =====================================================
        const DEGREES = {
            MD:  { en: 'M.D. (Ayurveda)',  hi: 'आयुर्वेद वाचस्पति', abbrHi: 'एम.डी. (आयुर्वेद)' },
            MS:  { en: 'M.S. (Ayurveda)',  hi: 'आयुर्वेद धन्वन्तरि', abbrHi: 'एम.एस. (आयुर्वेद)' },
            PHD: { en: 'Ph.D. (Ayurveda)', hi: 'विद्या वारिधि',     abbrHi: 'पीएच.डी. (आयुर्वेद)' }
        };
        const PART_HI = { I: 'प्रथम', II: 'द्वितीय', III: 'तृतीय', IV: 'चतुर्थ' };
        const ROMAN   = { '1': 'I', '2': 'II', '3': 'III', '4': 'IV' };

        // Specialization -> Hindi (zarurat ho to aur add kar dijiye)
        const SPEC_HI = [
            [/agad/i,                    'अगदतंत्र'],
            [/kaya\s*chikitsa/i,         'कायचिकित्सा'],
            [/panch\s*karma/i,           'पंचकर्म'],
            [/rasa\s*shastra/i,          'रसशास्त्र एवं भैषज्य कल्पना'],
            [/dravya\s*guna/i,           'द्रव्यगुण'],
            [/kaumar|bal\s*roga/i,       'कौमारभृत्य'],
            [/prasuti|stri\s*roga/i,     'प्रसूति तंत्र एवं स्त्री रोग'],
            [/shalakya/i,                'शालाक्य तंत्र'],
            [/shalya/i,                  'शल्य तंत्र'],
            [/rachana/i,                 'रचना शारीर'],
            [/kriya\s*sharir/i,          'क्रिया शारीर'],
            [/roga\s*nidan|vikriti/i,    'रोग निदान एवं विकृति विज्ञान'],
            [/swastha/i,                 'स्वस्थवृत्त एवं योग'],
            [/samhita|siddhant|basic/i,  'संहिता एवं सिद्धांत'],
            [/manas/i,                   'मानस रोग']
        ];

        function parseExam(full, session) {
            const out = { deg: null, part: '', spec: '', month: '', year: '' };
            const s = String(full || '').replace(/\s+/g, ' ').trim();

            const m = s.match(/^(M\.?\s*D|M\.?\s*S|Ph\.?\s*D)\.?\s*\(\s*(?:Ay|Ayu|Ayurveda)\.?\s*\)\s*(.*?)\s*Part[\s\-–]*([IVX]+|\d)\b/i);
            if (m) {
                out.deg  = DEGREES[m[1].replace(/[\s.]/g, '').toUpperCase()] || null;
                out.spec = m[2].trim();
                out.part = ROMAN[m[3]] || m[3].toUpperCase();
            }

            const h = s.match(/\(\s*([A-Za-z]+)[\s,\-]*(\d{4})\s*\)/) ||
                      String(session || '').match(/([A-Za-z]+)[\s(,\-]*(\d{4})/);
            if (h) {
                out.month = h[1].charAt(0).toUpperCase() + h[1].slice(1).toLowerCase();
                out.year  = h[2];
            }
            return out;
        }

        // QR ke liye Examname sirf "Part-II" tak:
        // "M.S. (Ay.) Shalya Tantra Part-II Odd BATCH-2022 MAIN EXAM (September 2026)" -> "M.S. (Ay.) Shalya Tantra Part-II"
        function qrCourse(full) {
            const s = String(full || '').replace(/\s+/g, ' ').trim();
            const m = s.match(/^.*?Part[\s\-–]*(?:[IVX]+|\d)\b/i);
            return m ? m[0].trim() : s;
        }

        function specToHindi(spec) {
            for (const [re, hi] of SPEC_HI) if (re.test(spec)) return hi;
            return '';
        }

        function toHindiCode(code) {
            return String(code || '')
                .replace(/\bMD\b/gi, 'एमडी')
                .replace(/\bPR\b/gi, 'प्रायो.');
        }

        function withCode(code, name) {
            name = String(name || '').trim();
            code = String(code || '').trim();
            if (!code || name.startsWith('(')) return name;
            return `(${code}) ${name}`;
        }

        function ordinalHtml(v) {
            const n = parseInt(v, 10);
            if (isNaN(n)) return esc(v);
            const s = (n % 100 >= 11 && n % 100 <= 13) ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] || 'th');
            return `${n}<sup>${s}</sup>`;
        }

        // Hindi naam bada/bold span me, English naam capital me
        function bothNames(hi, en) {
            hi = String(hi || '').trim();
            en = String(en || '').trim().toUpperCase();
            const h = hi ? `<span class="hi-name">${esc(hi)}</span>` : '';
            const e = en ? `<span class="en-name">${esc(en)}</span>` : '';
            return (h && e) ? `${h} / ${e}` : (h || e);
        }

        function markCell(v, max) {
            if (isBlank(v)) return '-';
            if (isAbsent(v)) return 'AB';
            if (max === 0 && num(v) === 0) return '-';
            return v;
        }

        // =====================================================
        // FETCH
        // =====================================================
        async function loadMarksheet() {

            const enrollmentNumber = EnrollmentNumber;
            const examId = ExamId;

            if (!enrollmentNumber || !examId) {

                alert("Enrollment Number or Exam ID is missing.");
                return;
            }

            try {

                const url = ApiBaseUrl +
                    `Result/GetMarsheetDataBAMSII?enrollmentNumber=${encodeURIComponent(enrollmentNumber)}&examId=${encodeURIComponent(examId)}`;

                console.log("Marksheet API URL:", url);

                const response = await fetch(url);

                if (!response.ok) {
                    let msg = "Unable to fetch marksheet data.";
                    try {
                        const e = await response.json();
                        msg = e.message || msg;
                    } catch (e) { }
                    alert(msg);
                    return;
                }

                const result = await response.json();

                console.log("Marksheet API Response:", result);

                if (!Array.isArray(result) || result.length === 0) {
                    alert("No marksheet data found.");
                    return;
                }

                bindMarksheet(result);
            }
            catch (error) {
                console.error("Marksheet Error:", error);
                alert("Something went wrong while loading marksheet.");
            }
        }

        // =====================================================
        // BIND
        // =====================================================
        function bindMarksheet(data) {
            const st = data[0];

            // ---------- Serial / Folio ----------
            setText('serialNo', pick(st, F.serialNo));
            setText('folioNo',  pick(st, F.folioNo));
            setText('serialbottom', pick(st, F.serialBottom));

            // ---------- Examname parse ----------
            const ex      = parseExam(pick(st, F.examFull), pick(st, F.session));
            const part    = ex.part;
            const partHi  = PART_HI[part] || part;
            const isFinal = part === 'II';
            const year    = ex.year;

            // ---------- Statement title ----------
            // "Statement of Marks obtained at the M.D. (AYURVEDA) PART-II (Final) Examination-2026"
            const stmtEn = pick(st, F.stmtEn) || (ex.deg
                ? `Statement of Marks obtained at the ${ex.deg.en.toUpperCase()} PART-${part}${isFinal ? ' (Final)' : ''} Examination-${year}`
                : '');
            // "एम.डी. (आयुर्वेद) पार्ट-द्वितीय (अंतिम) परीक्षा-2026 में प्राप्त अंकों का विवरण"
            const stmtHi = pick(st, F.stmtHi) || (ex.deg
                ? `${ex.deg.abbrHi} पार्ट-${partHi}${isFinal ? ' (अंतिम)' : ''} परीक्षा-${year} में प्राप्त अंकों का विवरण`
                : '');
            setText('stmtEn', stmtEn);
            setText('stmtHi', stmtHi);

            // ---------- Course block ----------
            const courseEn = pick(st, F.courseEn) || (ex.deg ? `${ex.deg.en} Part-${part}` : pick(st, F.examFull));
            const courseHi = pick(st, F.courseHi) || (ex.deg ? `${ex.deg.hi} भाग-${partHi}` : '');
            // English: SubjectNameCourseWise  |  Hindi: SubjectHindiNameCourseWise
            // (column khali ho tabhi Examname se backup)
            const specEnCol = pickAny(data, F.specEn);
            const specHiCol = pickAny(data, F.specHi);

            if (!specHiCol) console.warn('SubjectHindiNameCourseWise API response me nahi aaya / khali hai. Columns:', Object.keys(st));
            if (!specEnCol) console.warn('SubjectNameCourseWise API response me nahi aaya / khali hai. Columns:', Object.keys(st));

            const specEn   = specEnCol || ex.spec;
            const specHi   = specHiCol || specToHindi(specEn);

            setText('courseEn', courseEn);
            setText('courseHi', courseHi);
            setText('specEn',   specEn);
            setText('specHi',   specHi);

            const held = heldText(pick(st, F.heldOn)) || (ex.month ? `${ex.month} ${ex.year}` : '');
            setText('examEn', held ? `(Examination Held in ${held})` : '');
            setText('examHi', held ? `(परीक्षा सम्पादित ${toHindiMonth(held)})` : '');

            // ---------- Student ----------
            setHtml('nameBoth',   bothNames(pick(st, F.nameHi),   pick(st, F.nameEn)));
            setHtml('fatherBoth', bothNames(pick(st, F.fatherHi), pick(st, F.fatherEn)));
            setHtml('motherBoth', bothNames(pick(st, F.motherHi), pick(st, F.motherEn)));
            setText('rollNo',     pick(st, F.rollNo));
            setText('enrollNo',   pick(st, F.enrollNo));
            setHtml('attempt',    ordinalHtml(pick(st, F.attempt)));
            setText('resultDate', formatDate(pick(st, F.resultDate)));

            // ---------- Subject rows ----------
            let html = '', sumTotal = 0, sumMax = 0, sumMin = 0;
            const distHi = [], distEn = [], graceHi = [], graceEn = [], failHi = [], failEn = [];

            data.forEach(s => {
                const theory    = pick(s, F.theory);
                const practical = pick(s, F.practical);

                const tMax = num(pick(s, F.theoryMax)), pMax = num(pick(s, F.practMax));
                const tMin = num(pick(s, F.theoryMin)), pMin = num(pick(s, F.practMin));

                const maxMarks = num(pick(s, F.maxTotal)) || (tMax + pMax);
                const minMarks = num(pick(s, F.minTotal)) || (tMin + pMin);

                const apiTotal = pick(s, F.total);
                const total = apiTotal !== '' ? num(apiTotal) : num(theory) + num(practical);

                sumTotal += total; sumMax += maxMarks; sumMin += minMarks;

                const codeEn = pick(s, F.codeEn);
                const codeHi = pick(s, F.codeHi) || toHindiCode(codeEn);

                // ---- Fail check ----
                let fail = false;
                if (!isBlank(theory)    && (tMax > 0 || num(theory) > 0)    && (isAbsent(theory)    || num(theory)    < tMin)) fail = true;
                if (!isBlank(practical) && (pMax > 0 || num(practical) > 0) && (isAbsent(practical) || num(practical) < pMin)) fail = true;

                const dVal = pick(s, F.distinction).toUpperCase();
                const isDist = ['D', 'Y', 'YES', 'TRUE', '1'].includes(dVal);
                const hasGrace = num(pick(s, F.grace)) > 0;

                // ---- Remark: API ka ho to wahi, warna calculate ----
                let remark = pick(s, F.remark).toUpperCase();
                if (!remark) {
                    if (fail) remark = (isAbsent(theory) || isAbsent(practical)) ? 'AB' : 'F';
                    else if (hasGrace) remark = 'G';
                    else if (isDist) remark = 'D';
                }

                if (remark === 'F' || remark === 'AB') { failHi.push(codeHi);  failEn.push(codeEn); }
                else if (remark === 'G')               { graceHi.push(codeHi); graceEn.push(codeEn); }
                else if (remark === 'D')               { distHi.push(codeHi);  distEn.push(codeEn); }

                html += `
                    <tr class="${remark === 'G' ? 'grace-row' : ''}">
                        <td class="sub">
                            <div class="hi">${esc(withCode(codeHi, pick(s, F.paperHi)))}</div>
                            <div class="en">${esc(withCode(codeEn, pick(s, F.paperEn)))}</div>
                        </td>
                        <td class="num">${esc(maxMarks)}</td>
                        <td class="num">${esc(minMarks)}</td>
                        <td class="num">${esc(markCell(theory, tMax))}</td>
                        <td class="num">${esc(markCell(practical, pMax))}</td>
                        <td class="tot">${esc(total)}</td>
                        <td class="num">${esc(remark)}</td>
                    </tr>`;
            });

            setHtml('rows', html);

            // ---------- Totals ----------
            setText('maxAll', sumMax);
            setText('minAll', sumMin);

            const apiGT = pick(st, F.grandTotal);
            const grandTotal = apiGT !== '' ? num(apiGT) : sumTotal;
            setText('grandTotal', grandTotal);

            // ---------- Summary ----------
            const join = arr => arr.filter(Boolean).join(', ');
            setText('distHi',  join(distHi));
            setText('distEn',  join(distEn));
            setText('graceHi', join(graceHi));
            setText('graceEn', join(graceEn));
            setText('failHi',  join(failHi));
            setText('failEn',  join(failEn));

            // ---------- Result ----------
            let res = pick(st, F.result).toUpperCase();
            if (!res) res = failEn.length ? 'FAIL' : 'PASS';

            const RES_HI = { 'PASS': 'उत्तीर्ण', 'FAIL': 'अनुत्तीर्ण', 'ABSENT': 'अनुपस्थित' };
            setText('resultText', RES_HI[res] ? `${RES_HI[res]}/${res}` : res);

            // ---------- QR ----------
            generateQRCode({
                rollNo:  pick(st, F.rollNo),
                name:    pick(st, F.nameEn).toUpperCase(),
                course:  qrCourse(pick(st, F.examFull)) || courseEn,   // "M.S. (Ay.) Shalya Tantra Part-II"
                result:  res,
                total:   grandTotal,
                uuid:    pick(st, F.uuid)
            });
        }

        // =====================================================
        // QR CODE
        // Format:
        // Roll No: 2202033; Name: DHARTI; Course: M.D.(Ayurveda) Part-II; Result: PASS; Total Marks: 412;Url: https://nia.edu.in/resultverification.php?uuid=...
        // =====================================================
        function generateQRCode(q) {
            const qr = document.getElementById('qr');
            if (!qr) return;
            qr.innerHTML = '';

            if (typeof QRCode === 'undefined') {
                console.warn('QR Code library not loaded.');
                return;
            }

            const text =
                `Roll No: ${q.rollNo}; ` +
                `Name: ${q.name}; ` +
                `Course: ${q.course}; ` +
                `Result: ${q.result}; ` +
                `Total Marks: ${q.total};` +
                `Url: ${VERIFY_URL}${encodeURIComponent(q.uuid)}`;

            console.log("QR Text:", text);

            new QRCode(qr, { text: text, width: 256, height: 256, correctLevel: QRCode.CorrectLevel.M });
        }

        // =====================================================
        // PRINT FIT: content zyada ho to frame ko chhota (zoom) kar do
        // taaki border + footer ek hi page par aaye
        // =====================================================
        const MM = 96 / 25.4;   // 1mm in px
        const FRAME_MM = 272;   // A4 296mm - 12mm upar - 12mm neeche (page padding)

        function fitForPrint() {
            const frame = document.querySelector('.frame');
            if (!frame) return;

            frame.style.zoom = '';
            frame.style.height = 'auto';
            frame.style.minHeight = '0';

            const available = FRAME_MM * MM;
            const needed    = Math.max(frame.scrollHeight, frame.offsetHeight);

            // neeche round karo (upar round hone se content 1-2px bahar nikal jaata tha)
            const z = needed > available ? Math.floor((available / needed) * 1000) / 1000 : 1;

            frame.style.height = '';
            frame.style.minHeight = '';
            if (z < 1) {
                frame.style.zoom = String(z);
                frame.style.height = (FRAME_MM / z) + 'mm';
            }
        }

        function resetAfterPrint() {
            const frame = document.querySelector('.frame');
            if (!frame) return;
            frame.style.zoom = '';
            frame.style.height = '';
            frame.style.minHeight = '';
        }

        window.addEventListener('beforeprint', fitForPrint);
        window.addEventListener('afterprint', resetAfterPrint);

        // =====================================================
        // PRINT POPUP  (Serial No / Folio No / Bottom Serial)
        // =====================================================
        const $id = id => document.getElementById(id);

        function openPrintPopup() {
            $id('printSerialNo').value     = $id('serialNo').textContent.trim();
            $id('printFolioNo').value      = $id('folioNo').textContent.trim();
            $id('printBottomSerial').value = $id('serialbottom').textContent.trim();

            $id('printModal').style.display = 'flex';
            $id('printSerialNo').focus();
        }

        function closePrintPopup() {
            $id('printModal').style.display = 'none';
        }

        function saveAndPrint() {
            const serialNo  = $id('printSerialNo').value.trim();
            const folioNo   = $id('printFolioNo').value.trim();
            const bottomNo  = $id('printBottomSerial').value.trim();

            if (!serialNo) { alert('Please enter Serial No.');        $id('printSerialNo').focus();     return; }
            if (!folioNo)  { alert('Please enter Folio No.');         $id('printFolioNo').focus();      return; }
            if (!bottomNo) { alert('Please enter Bottom Serial No.'); $id('printBottomSerial').focus(); return; }

            // Marksheet me set
            $id('serialNo').textContent     = serialNo;
            $id('folioNo').textContent      = folioNo;
            $id('serialbottom').textContent = bottomNo;

            closePrintPopup();

            // DOM update ke baad print
            setTimeout(() => window.print(), 200);
        }

        // ESC se band
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && $id('printModal').style.display === 'flex') closePrintPopup();
        });

        // Bahar click se band
        document.addEventListener('click', e => {
            if (e.target && e.target.id === 'printModal') closePrintPopup();
        });

        // Popup me Enter dabane par Save & Print
        document.addEventListener('keydown', e => {
            if (e.key === 'Enter' && $id('printModal').style.display === 'flex') {
                e.preventDefault();
                saveAndPrint();
            }
        });

        document.addEventListener('DOMContentLoaded', loadMarksheet);
    </script>

</body>
</html>