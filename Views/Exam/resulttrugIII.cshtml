<script>
        $(document).ready(function () {
        loadSession();
        });
         function loadSession() {
           $.get(ApiBaseUrl + 'Course/GetSession', function (res) {
               let session = '<option value="">Select Session</option>';
               res.forEach(x => {
                   session += `<option value="${x.sessionId}">${x.sessionName}</option>`;
               });
               $('#sessionId').html(session);
           });
         }
         function loadPrograms() {
           $.get(ApiBaseUrl + 'Course/GetPrograms', function (res) {
               let opt = '<option value="">Select Program</option>';
               res.forEach(x => {
                   opt += `<option value="${x.programId}">${x.programName}</option>`;
               });
               $('#programId').html(opt);
           });
         }
         document.getElementById("programId").addEventListener("change", function () {
        let programId = this.value;
        $("#courseId").val('');
        $("#semester").val('');
        $("#subjectId").val('');
        fetch(ApiBaseUrl + `Subject/courses/${programId}`)
            .then(res => res.json())
            .then(data => {
                let courseDropdown = document.getElementById("courseId");
                courseDropdown.innerHTML = '<option value="">Select Course</option>';
                data.forEach(item => {
                     courseDropdown.innerHTML += `<option value="${item.course_Id}">${item.course_Name}</option>`;
                });
            });
     });
       document.getElementById("courseId").addEventListener("change", function () {
        let courseId = this.value;
        $("#semester").val('');
        $("#BatchId").val('');
        fetch(ApiBaseUrl + `Subject/semester/${courseId}`)
            .then(res => res.json())
            .then(data => {
                let courseDropdown = document.getElementById("semester");
                courseDropdown.innerHTML = '<option value="">Select Semester</option>';
                data.forEach(item => {
                     courseDropdown.innerHTML += `<option value="${item.semesterId}">${item.semesterName}</option>`;
                });
            });
      });
      $("#semester").on("change", function () {
           let semId = this.value;
           let courseId = $("#courseId").val();
           $("#BatchId").html('<option value="">Select Batch</option>');
           if (!semId) return;
           $.get(ApiBaseUrl + `Subject/getBatch/${semId}/${courseId}`, function (data) {
               let opt = '<option value="">Select Batch</option>';
               data.forEach(item => opt += `<option value="${item.batchname}">${item.batchname}</option>`);
               $("#BatchId").html(opt);
           });
       });




    async function loadResultforBamsSecond() {

         const courseId = $("#courseId").val();
         const semester = $("#semester").val();
         const sessionId = $("#sessionId").val();
         let BatchId = $("#BatchId").val();

         const response = await fetch(
             ApiBaseUrl +
             `Result/GetTabulationRegisterResultReportforbamsIII?courseId=${courseId}&semester=${semester}&sessionId=${sessionId}&btcId=${BatchId}`
         );

         const data = await response.json();

         if (!data || data.length === 0) {
             $("#ExamnameId").text('');
             $("#resultBody2").html('');
             alert("No records found for the selected Session, Course and Semester.");
             return;
         }

         $("#ExamnameId").text(data[0].examname || '');

         // Group student-wise
         let grouped = {};

         data.forEach(item => {

             let key = item.rollNumber;

             if (!grouped[key]) {
                 grouped[key] = [];
             }

             grouped[key].push(item);
         });

         let html = '';
         let sno = 1;

         /* ================================================================
            *** FIX: Script ID I / II / III display ***
            Border/padding scoped to just these three columns via inline
            !important, winning over .kk's border-left/right: none !important.
            Width is now handled by the table's <colgroup> (columns 5-7)
            instead of here - under table-layout: fixed (set in
            TrStyleSheet.css), width/min-width on a body <td> has no effect
            on the actual rendered column width; only <col> elements (or the
            very first row) do. That's why earlier width attempts here alone
            didn't work - the <colgroup> was the missing piece.
            ================================================================ */
         const scriptIdCellStyle = 'border-left:2px solid #000 !important; border-right:2px solid #000 !important; padding:4px 10px !important; white-space:nowrap !important;';

         Object.keys(grouped).forEach(key => {

             let student = grouped[key];
             let first = student[0];

             html += `
             <tr>

                 <!-- S.No -->
                 <td class="data-cell">
                     ${sno++}
                 </td>
                 <td>
                     ${first.rollNumber}
                     <hr/>
                     ${first.enrollmentNumber}
                     <hr/>
                     ${first.firstName}
                     <hr/>
                     ${first.fatherName}
                 </td>


                 <!-- Attempt -->
                 <td class="data-cell">
                     ${first.attempt || ''}
                 </td>



                 <!-- Subject Name -->
                 <!-- FIX: subject name se aage ki saari per-subject
                      columns mein ab wrapCell() lagaya hai - jis subject
                      mein grace lagi hai uski line YELLOW, jo fail hai
                      uski line RED dikhegi (chahe ye ek hi <td> ke andar
                      multiple subjects <br> se joined kyun na ho). -->
                 <td class="data-cell kk" style="border: 1px solid #000; padding:3px 4px; text-align:left;">
                     ${student.map(x => wrapCell(x, x.subjectName || '-')).join('<br>')}
                 </td>

                 <!-- Script ID I -->
                 <td class="data-cell kk" style="${scriptIdCellStyle}">
                     ${student.map(x => wrapCell(x, x.scriptIdI || '-')).join('<br>')}
                 </td>

                 <!-- Script ID II -->
                 <td class="data-cell kk" style="${scriptIdCellStyle}">
                     ${student.map(x => wrapCell(x, x.scriptIdII || '-')).join('<br>')}
                 </td>

                 <!-- Script ID III -->
                 <td class="data-cell kk" style="${scriptIdCellStyle}">
                     ${student.map(x => wrapCell(x, x.scriptIdIII || '-')).join('<br>')}
                 </td>

                 <!-- Marks Scheme: Theory I (max) -->
                 <td class="data-cell kk">
                     ${student.map(x => wrapCell(x, fmtMark(x.theoryI))).join('<br>')}
                 </td>

                 <!-- Marks Scheme: Theory II (max) -->
                 <td class="data-cell kk">
                     ${student.map(x => wrapCell(x, fmtMark(x.theoryII || '-'))).join('<br>')}
                 </td>

                 <!-- Marks Scheme: Theory III (max) -->
                 <td class="data-cell kk">
                     ${student.map(x => wrapCell(x, fmtMark(x.theoryIII || '-'))).join('<br>')}
                 </td>

                 <!-- Marks Scheme: Practical (max) -->
                 <td class="data-cell kk">
                     ${student.map(x => wrapCell(x, fmtMark(x.practical))).join('<br>')}
                 </td>

                 <!-- Marks Scheme: Viva (max) -->
                 <td class="data-cell kk">
                     ${student.map(x => wrapCell(x, fmtMark(x.vivaMarks))).join('<br>')}
                 </td>

