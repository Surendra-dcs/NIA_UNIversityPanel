     /* ============================================================
        fmtMark — display helper

        - Number aaye to nearest whole number tak ROUND karke dikhata
          hai (floating-point garbage jaise 41.000000000004 ab kabhi
          nahi dikhega).
        - 'AB' ya koi bhi non-numeric text (Theory marks absent hone
          par 'AB' bhej sakta hai) ko bina tode/error diye JAISA HAI
          WAISA hi dikha deta hai.
        - null/undefined/khaali value ke liye '-' dikhata hai.
        ============================================================ */
     function fmtMark(v) {
         if (v === null || v === undefined || v === '') return '-';
         const num = parseFloat(v);
         if (isNaN(num)) return v;   // e.g. 'AB' - as-is, round mat karo
         return Math.round(num).toString();
     }
         function fmtMarkZeroDash(v) {
        let result = fmtMark(v);
        return result === '0' ? '-' : result;
    }
     /* ============================================================
        subjectBg — us subject ke liye background color decide karta
        hai:
        - Required_To_Appear bhara hua => subject FAIL => red
        - GraceMarks bhara hua         => subject GRACE => yellow
        - warna                        => koi highlight nahi
        ============================================================ */
     function subjectBg(item) {
         if (item.required_To_Appear) return '#ffd6d6';   // FAIL - red
         if (item.graceMarks) return '#fff3b0';            // GRACE - yellow
         return '';
     }

     /* ============================================================
        wrapCell — Subject Name se lekar aage ki har per-subject
        column ke value ko ek block-level <span> mein wrap karta hai,
        jisse us subject ki poori "line" (is column ke andar) colored
        dikhti hai - is tarah ek hi <td> ke andar kayi subjects
        <br> se joined hone ke bawajood, har subject ki apni row-jaisi
        colored strip ban jaati hai.
        ============================================================ */
     function wrapCell(item, value) {
         let bg = subjectBg(item);
         if (!bg) return value;
         return `<span style="display:block;background:${bg};padding:2px 4px;margin:-2px -4px;">${value}</span>`;
     }


     function fmtMark(v) {
         if (v === null || v === undefined || v === '') return '-';
         const num = parseFloat(v);
         if (isNaN(num)) return v;   // e.g. 'AB' - as-is, round mat karo
         return Math.round(num).toString();
     }


