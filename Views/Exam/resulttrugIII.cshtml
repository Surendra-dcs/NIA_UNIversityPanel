@{
    ViewData["Title"] = "Result";
    Layout = "~/Views/Shared/_UniversityLayout.cshtml";
}


<link href="~/css/TrStyleSheetugIII.css" rel="stylesheet" />
<script src="~/js/PrinttrugIII.js"></script>
<style>
    .search-panel {
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

    .search-title {
        font-size: 20px;
        font-weight: 600;
        color: #0d3b66;
        margin-bottom: 15px;
    }

    .search-row {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: end;
    }

    .search-group {
        min-width: 220px;
        flex: 1;
    }

        .search-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .search-group select {
            width: 100%;
            height: 38px;
            border: 1px solid #ccc;
            border-radius: 5px;
            padding: 0 10px;
        }

    .btn-group {
        flex: 0;
    }

        .btn-group button {
            height: 38px;
            padding: 0 25px;
            border: none;
            background: #0d6efd;
            color: #fff;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
        }

            .btn-group button:hover {
                background: #0b5ed7;
            }

    .download-btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .search-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
    }

    .print-page {
        position: relative;
        page-break-after: always;
        min-height: 190mm;
    }

        .print-page:last-child {
            page-break-after: auto;
        }

    .s1 {
        padding: 5px;
    }

</style>

<style>
    body {
        font-family: Arial, Helvetica, sans-serif;
        padding: 20px;
        background: #f5f5f5;
        overflow-x: hidden; /* *** FIX: backstop so the page itself can
                never scroll sideways - only the ledger's own wrapper div
                (overflow-x:auto) can. Without this, if anything inside ever
                pushes wider than the viewport again, the whole page (footer
                included) would scroll instead of just the table area. */
    }

    table.ledger {
        border-collapse: collapse;
        width: 100%;
        background: #fff;
        font-size: 12px;
    }

        table.ledger th, table.ledger td {
            border: 1px solid #000;
            padding: 3px 4px;
            text-align: center;
            vertical-align: middle;
        }

        table.ledger thead th {
            background: #fff;
            font-weight: bold;
        }

    .group-head {
        font-size: 12px;
    }

    .subject-head {
        min-width: 140px;
    }

    .roll-head {
        min-width: 150px;
        text-align: left;
    }

    .vertical {
        white-space: nowrap;
    }

    .vertical-col {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        padding: 6px 2px;
        height: 130px;
    }

        .vertical-col.tall {
            height: 232px;
        }

    td.data-cell {
        height: 34px;
        line-height: 20px;
    }

    .border-none {
        border: none !important;
    }

    .k {
        border: none !important;
    }

    .no-right-border {
        border-right: none !important;
    }

    .no-bottom-border {
        border-bottom: none !important;
    }

    .kk {
        border-left: none !important;
        border-right: none !important;
        padding: 4px 10px !important;
    }


    .kkk {
        border-left: none !important;
        border-bottom: none !important;
    }

    .kkkk {
        border-left: none !important;
        border-bottom: none !important;
        border-right: none !important;
    }

    /* ================================================================
           *** FIX: Script ID I / II / III specifically ***
           .kk (used above) force-removes left/right borders on every data
           column, including these three - that's why scriptIdI/II/III run
           together with no visible gap between them ("203517" + "203400"
           reading as one number). Scoped ONLY to Script ID as asked, using
           an inline !important style on those three <td>s below rather than
           editing .kk itself, so no other column's styling changes. Inline
           !important beats .kk's !important regardless of what TrStyleSheet.css
           (which I can't see) might also be doing to these cells.
           ================================================================ */
</style>



