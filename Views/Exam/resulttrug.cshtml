<style>
    .search-panel {
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

    .search-title {
        font-size: 20px;
        font-weight: 600;
        color: #0d3b66;
        margin-bottom: 15px;
    }

    .search-row {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: end;
    }

    .search-group {
        min-width: 220px;
        flex: 1;
    }

        .search-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .search-group select {
            width: 100%;
            height: 38px;
            border: 1px solid #ccc;
            border-radius: 5px;
            padding: 0 10px;
        }

    .btn-group {
        flex: 0;
    }

        .btn-group button {
            height: 38px;
            padding: 0 25px;
            border: none;
            background: #0d6efd;
            color: #fff;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
        }

            .btn-group button:hover {
                background: #0b5ed7;
            }

    .download-btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .search-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
    }

    .print-page {
        position: relative;
        page-break-after: always;
        min-height: 190mm;
    }

        .print-page:last-child {
            page-break-after: auto;
        }

    .s1{
    padding: 5px;
    }

</style>

<style>
    body {
        font-family: Arial, Helvetica, sans-serif;
        padding: 20px;
        background: #f5f5f5;
    }

    table.ledger {
        border-collapse: collapse;
        width: 100%;
        background: #fff;
        font-size: 12px;
    }

        table.ledger th, table.ledger td {
            border: 1px solid #000;
            padding: 3px 4px;
            text-align: center;
            vertical-align: middle;
        }  

        table.ledger thead th {
            background: #fff;
            font-weight: bold;
        }

    .group-head {
        font-size: 12px;
    }

    .subject-head {
        min-width: 140px;
    }

    .roll-head {
        min-width: 150px;
        text-align: left;
    }

    .vertical {
        white-space: nowrap;
    }

    .vertical-col {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        padding: 6px 2px;
        height: 130px;
    }

        .vertical-col.tall {
            height: 232px;
        }

    td.data-cell {
        height: 34px;
        line-height: 20px;
    }

    .border-none{
        border:none !important;
    }

    .k {
        border: none !important;
    }

    .no-right-border {
        border-right: none !important;
    }

    .no-bottom-border {
        border-bottom: none !important;
    }

    .kk {
        border-left: none !important;
        border-right: none !important;
    }

    .kkk {
        border-left: none !important;
        border-bottom: none !important;

    }

    .kkkk {
        border-left: none !important;
        border-bottom: none !important;
        border-right: none !important;
    }

</style>



<div class="search-panel">

    <div class="search-title">
        🔍 Tabulation Register Search
        <div class="action-buttons">
            <button type="button"
                    onclick="printTable()"
                    style="width:98px; height:38px; font-weight:800; background:#3b8508; color:white; cursor:pointer;">
                Print
            </button>

        </div>
    </div>

    <div class="search-row">

        <div class="search-group">
            <label>Session</label>
            <select id="sessionId">
                <option value="">Select Session</option>
            </select>
        </div>

        <div class="search-group">
            <label>Program</label>
            <select id="programId">
                <option value="">Select Program</option>
                <option value="1">Under Graduate (UG)</option>
            </select>
        </div>

        <div class="search-group">
            <label>Course</label>
            <select id="courseId">
                <option value="">Select Course</option>
            </select>
        </div>

        <div class="search-group">
            <label>Semester</label>
            <select id="semester">
                <option value="">Select Semester</option>
            </select>
        </div>
        <div class="search-group">
            <label>Batch </label>
            <select id="BatchId">
                <option value="">Select Batch</option>
            </select>
        </div>

        <div class="search-group btn-group">
            <button type="button" onclick="loadResultforBamsSecond()">
                Search Report
            </button>           
        </div>
    
       
    </div>
</div>


