    <script>
        $(document).ready(function () {        
        loadSession();
        });
         function loadSession() {
           $.get(ApiBaseUrl + 'Course/GetSession', function (res) {
               let session = '<option value="">Select Session</option>';
               res.forEach(x => {
                   session += `<option value="${x.sessionId}">${x.sessionName}</option>`;
               });
               $('#sessionId').html(session);
           });
         }
         function loadPrograms() {
           $.get(ApiBaseUrl + 'Course/GetPrograms', function (res) {
               let opt = '<option value="">Select Program</option>';
               res.forEach(x => {
                   opt += `<option value="${x.programId}">${x.programName}</option>`;
               });
               $('#programId').html(opt);
           });
         }
         document.getElementById("programId").addEventListener("change", function () {
        let programId = this.value;
        $("#courseId").val('');
        $("#semester").val('');
        $("#subjectId").val('');
        fetch(ApiBaseUrl + `Subject/courses/${programId}`)
            .then(res => res.json())
            .then(data => {
                let courseDropdown = document.getElementById("courseId");
                courseDropdown.innerHTML = '<option value="">Select Course</option>';                   
                data.forEach(item => {
                     courseDropdown.innerHTML += `<option value="${item.course_Id}">${item.course_Name}</option>`;
                });
            });
     });
       document.getElementById("courseId").addEventListener("change", function () {
        let courseId = this.value;
        $("#semester").val('');     
        $("#BatchId").val('');
        fetch(ApiBaseUrl + `Subject/semester/${courseId}`)
            .then(res => res.json())
            .then(data => {
                let courseDropdown = document.getElementById("semester");
                courseDropdown.innerHTML = '<option value="">Select Semester</option>';
                data.forEach(item => {
                     courseDropdown.innerHTML += `<option value="${item.semesterId}">${item.semesterName}</option>`;
                });
            });
      });
      $("#semester").on("change", function () {
           let semId = this.value;
           let courseId = $("#courseId").val();
           $("#BatchId").html('<option value="">Select Batch</option>');
           if (!semId) return;
           $.get(ApiBaseUrl + `Subject/getBatch/${semId}/${courseId}`, function (data) {
               let opt = '<option value="">Select Batch</option>';
               data.forEach(item => opt += `<option value="${item.batchname}">${item.batchname}</option>`);
               $("#BatchId").html(opt);
           });
       });
     




      async function loadResultforBamsSecond() {

        const courseId = $("#courseId").val();
        const semester = $("#semester").val();
        const sessionId = $("#sessionId").val();
        let BatchId = $("#BatchId").val();

        const response = await fetch(
            ApiBaseUrl +
            `Result/GetTabulationRegisterResultReportforbamssecond?courseId=${courseId}&semester=${semester}&sessionId=${sessionId}&btcId=${BatchId}`
        );

        const data = await response.json();

        if (!data || data.length === 0) {
            $("#ExamnameId").text('');
            $("#resultBody").html('');
            alert("No records found for the selected Session, Course and Semester.");
            return;
        }

        $("#ExamnameId").text(data[0].examname || '');

        // Group student-wise
        let grouped = {};

        data.forEach(item => {

            let key = item.rollNumber;

            if (!grouped[key]) {
                grouped[key] = [];
            }

            grouped[key].push(item);
        });

        let html = '';
        let sno = 1;

        Object.keys(grouped).forEach(key => {

            let student = grouped[key];
            let first = student[0];

            html += `
            <tr>

                <!-- S.No -->
                <td class="data-cell">
                    ${sno++}
                </td>
                <td>
                    ${first.rollNumber}
                    <hr/>
                    ${first.enrollmentNumber}
                    <hr/>
                    ${first.firstName}
                    <hr/>
                    ${first.fatherName}
                </td>
              

                <!-- Attempt -->
                <td class="data-cell">
                    ${first.attempt || ''}
                </td>

         

                <!-- Subject Name -->
                <td class="data-cell kk" style="border: 1px solid #000; padding:3px 4px; text-align:left;">
                    ${student.map(x => x.subjectName || '-').join('<br>')}
                </td>

                <!-- Script ID I -->
                <td class="data-cell kk">
                    ${student.map(x => x.scriptIdI || '-').join('<br>')}
                </td>

                <!-- Script ID II -->
                <td class="data-cell kk">
                    ${student.map(x => x.scriptIdII || '-').join('<br>')}
                </td>

                <!-- Theory I -->
                <td class="data-cell kk">
                    ${student.map(x => x.theoryI || '-').join('<br>')}
                </td>

                <!-- Theory II -->
                <td class="data-cell kk">
                    ${student.map(x => x.theoryII || '-').join('<br>')}
                </td>

                <!-- Practical -->
                <td class="data-cell kk">
                    ${student.map(x => x.practical || '-').join('<br>')}
                </td>

                <!-- Viva Marks -->
                <td class="data-cell kk">
                    ${student.map(x => x.vivaMarks || '-').join('<br>')}
                </td>

                <!-- Elective Marks -->
                <td class="data-cell kk">
                    ${student.map(x => x.electiveMarks || '-').join('<br>')}
                </td>

                <!-- IA Marks -->
                <td class="data-cell kk">
                    ${student.map(x => x.iaMarks || '-').join('<br>')}
                </td>

                <!-- Grand Total Marks -->
                <td class="data-cell kk">
                    ${student.map(x => x.grandTotalMarks || '-').join('<br>')}
                </td>

                <!-- Theory I Evaluator 1 -->
                <td class="data-cell kk">
                    ${student.map(x => x.thearyIEvaluator1 || '-').join('<br>')}
                </td>

                <!-- Theory I Evaluator 2 -->
                <td class="data-cell kk">
                    ${student.map(x => x.thearyIEvaluator2 || '-').join('<br>')}
                </td>

                <!-- Theory I Difference -->
                <td class="data-cell kk">
                    ${student.map(x =>
                        x.thearyIDifference12 != null
                            ? Number(x.thearyIDifference12).toFixed(2)
                            : '-'
                    ).join('<br>')}
                </td>

                <!-- Theory I Evaluator 3 -->
                <td class="data-cell kk">
                    ${student.map(x => x.thearyIEvaluator3 || '-').join('<br>')}
                </td>

                <!-- Theory I Average -->
                <td class="data-cell kk">
                    ${student.map(x =>
                        x.thearyIAverageOfTwoHigherMarks != null
                            ? Number(x.thearyIAverageOfTwoHigherMarks).toFixed(2)
                            : '-'
                    ).join('<br>')}
                </td>

                <!-- Theory II Evaluator 1 -->
                <td class="data-cell kk">
                    ${student.map(x => x.thearyIIEvaluator1 || '-').join('<br>')}
                </td>

                <!-- Theory II Evaluator 2 -->
                <td class="data-cell kk">
                    ${student.map(x => x.thearyIIEvaluator2 || '-').join('<br>')}
                </td>

                <!-- Theory II Difference -->
                <td class="data-cell kk">
                    ${student.map(x =>
                        x.thearyIIDifference12 != null
                            ? Number(x.thearyIIDifference12).toFixed(2)
                            : '-'
                    ).join('<br>')}
                </td>

                <!-- Theory II Evaluator 3 -->
                <td class="data-cell kk">
                    ${student.map(x => x.thearyIIEvaluator3 || '-').join('<br>')}
                </td>

                <!-- Theory II Average -->
                <td class="data-cell kk">
                    ${student.map(x =>
                        x.thearyIIAverageOfTwoHigherMarks != null
                            ? Number(x.thearyIIAverageOfTwoHigherMarks).toFixed(2)
                            : '-'
                    ).join('<br>')}
                </td>

                <!-- Final Theory I -->
                <td class="data-cell kk">
                    ${student.map(x => x.finalTheoryIMarks || '-').join('<br>')}
                </td>

                <!-- Final Theory II -->
                <td class="data-cell kk">
                    ${student.map(x => x.finalTheoryIIMarks || '-').join('<br>')}
                </td>

                <!-- Theory Total -->
                <td class="data-cell kk">
                    ${student.map(x => x.theoryTotal || '-').join('<br>')}
                </td>

                <!-- Obtained Practical -->
                <td class="data-cell kk">
                    ${student.map(x => x.obtenPracticalMarks || '-').join('<br>')}
                </td>

                <!-- Obtained Viva -->
                <td class="data-cell kk">
                    ${student.map(x => x.obtenVivaMarks || '-').join('<br>')}
                </td>

                <!-- Obtained Elective -->
                <td class="data-cell kk">
                    ${student.map(x => x.obtenElativeMarks || '-').join('<br>')}
                </td>

                <!-- Obtained IA -->
                <td class="data-cell kk">
                    ${student.map(x => x.obtenIAMarks || '-').join('<br>')}
                </td>

                <!-- Practical Total -->
                <td class="data-cell kk">
                    ${student.map(x => x.practicalTotal || '-').join('<br>')}
                </td>


                <!-- Subject Total -->
                <td class="data-cell kk">
                    ${student.map(x => x.subjectTotal || '').join('<br>')}
                </td>
                <!-- Grace Marks -->
                <td class="data-cell kk">
                    ${student.map(x => x.graceMarks || '').join('<br>')}
                </td>


                <!-- Required To Appear -->
                <td class="data-cell kk">
                    ${student
                        .filter(x => x.required_To_Appear)
                        .map(x => x.required_To_Appear)
                        .join('<br>')}
                </td>

                <!-- Distinction -->
                <td class="data-cell kk">
                    ${student
                        .filter(x => x.distinction)
                        .map(x => x.distinction)
                        .join('<br>')}
                </td>

                <!-- Grand Total -->
                <td class="data-cell">
                    ${first.grandTotal || '-'}
                </td>

                <!-- Result -->
                <td class="data-cell">
                    ${first.result || ''}
                </td>

            </tr>`;
        });

        $("#resultBody2").html(html);
    }

</script>

