@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Result For CSV & Excel";
    Layout = "~/Views/Shared/_UniversityLayout.cshtml";
    var apiBase = Configuration["ApiSettings:BaseUrl"];
}

<style>
    .dl-panel {
        background: #fff;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        padding: 18px;
        margin: 16px 0 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

    .dl-title {
        font-size: 20px;
        font-weight: 600;
        color: #0d3b66;
        margin-bottom: 16px;
    }

    .dl-row {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: flex-end;
    }

    .dl-group {
        min-width: 200px;
        flex: 1;
    }

        .dl-group label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .dl-group select {
            width: 100%;
            height: 40px;
            border: 1px solid #ccc;
            border-radius: 5px;
            padding: 0 10px;
            background: #fff;
        }

            .dl-group select:disabled {
                background: #f1f3f5;
                color: #9aa0a6;
                cursor: not-allowed;
            }

            .dl-group select:focus {
                outline: none;
                border-color: #0d6efd;
                box-shadow: 0 0 0 3px rgba(13,110,253,.15);
            }

    .dl-step {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #e7f0ff;
        color: #0d6efd;
        font-size: 11px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .dl-btn-wrap {
        flex: 0 0 auto;
        min-width: 150px;
    }

    .dl-btn {
        width: 100%;
        height: 40px;
        border: none;
        background: #0d6efd;
        color: #fff;
        border-radius: 5px;
        cursor: pointer;
        font-weight: 600;
    }

        .dl-btn:hover:not(:disabled) {
            background: #0b5ed7;
        }

        .dl-btn:disabled {
            cursor: not-allowed;
            opacity: .6;
        }

    .dl-note {
        margin-top: 12px;
        font-size: 13px;
        color: #666;
    }
</style>

<div class="dl-panel">

    <div class="dl-title">&#128269; Result Sheet Download (CSV &amp; Excel)</div>

    <div class="dl-row">
        <div class="dl-group">
            <label for="ddlExam"><span class="dl-step">1</span> Exam</label>
            <select id="ddlExam"><option value="">Select Exam</option></select>
        </div>

        <div class="dl-group">
            <label for="ddlCourse"><span class="dl-step">2</span> Course</label>
            <select id="ddlCourse" disabled><option value="">Select Course</option></select>
        </div>

        <div class="dl-group">
            <label for="ddlSemester"><span class="dl-step">3</span> Semester</label>
            <select id="ddlSemester" disabled><option value="">Select Semester</option></select>
        </div>

        <div class="dl-group">
            <label for="ddlBatch"><span class="dl-step">4</span> Batch</label>
            <select id="ddlBatch" disabled><option value="">Select Batch</option></select>
        </div>

        <div class="dl-group">
            <label for="downloadType"><span class="dl-step">5</span> Download Type</label>
            <select id="downloadType">
                <option value="">Select Type</option>
                <option value="excel">Excel</option>
                <option value="csv">CSV</option>
            </select>
        </div>

        <div class="dl-btn-wrap">
            <button type="button" id="btnDownload" class="dl-btn">Download</button>
        </div>
    </div>

    <div class="dl-note">Please select an Exam first. The Course, Semester, and Batch options will then open automatically, one after another.</div>
</div>

<script>
    const apiBase = '@apiBase'.replace(/\/$/, '');
    const api = apiBase + '/Result/';

    const ddl = {
        exam: document.getElementById('ddlExam'),
        course: document.getElementById('ddlCourse'),
        sem: document.getElementById('ddlSemester'),
        batch: document.getElementById('ddlBatch')
    };
    const downloadType = document.getElementById('downloadType');
    const btnDownload = document.getElementById('btnDownload');
    const BTN_TEXT = 'Download';

    function getJson(url) {
        return fetch(url).then(r => { if (!r.ok) throw new Error(r.status); return r.json(); });
    }

    function fillDropdown(el, placeholder, data, valueKey, textKey) {
        el.innerHTML = `<option value="">${placeholder}</option>`;
        data.forEach(x => {
            const opt = document.createElement('option');
            opt.value = x[valueKey];
            opt.text = x[textKey];
            el.appendChild(opt);
        });
        el.disabled = data.length === 0;
    }

    function resetFrom(...els) {
        const labels = { ddlCourse: 'Course', ddlSemester: 'Semester', ddlBatch: 'Batch' };
        els.forEach(el => fillDropdown(el, `Select ${labels[el.id]}`, [], '', ''));
    }

    const selText = el => el.options[el.selectedIndex].text;

    // ---------- Filters ----------
    getJson(api + 'GetMdMsResultExams')
        .then(d => fillDropdown(ddl.exam, 'Select Exam', d, 'exId', 'examYear'))
        .then(() => { ddl.exam.disabled = false; })
        .catch(() => alert('Exam list load nahi hui.'));

    ddl.exam.addEventListener('change', function () {
        resetFrom(ddl.course, ddl.sem, ddl.batch);
        if (!this.value) return;
        getJson(`${api}GetMdMsResultCourses?exId=${this.value}`)
            .then(d => fillDropdown(ddl.course, 'Select Course', d, 'courseId', 'courseName'))
            .catch(() => alert('Course list load nahi hui.'));
    });

    ddl.course.addEventListener('change', function () {
        resetFrom(ddl.sem, ddl.batch);
        if (!this.value) return;
        getJson(`${api}GetMdMsResultSemesters?exId=${ddl.exam.value}&courseId=${this.value}`)
            .then(d => fillDropdown(ddl.sem, 'Select Semester', d, 'semId', 'semesterName'))
            .catch(() => alert('Semester list load nahi hui.'));
    });

    ddl.sem.addEventListener('change', function () {
        resetFrom(ddl.batch);
        if (!this.value) return;
        getJson(`${api}GetMdMsResultBatches?exId=${ddl.exam.value}&courseId=${ddl.course.value}&semId=${this.value}`)
            .then(d => fillDropdown(ddl.batch, 'Select Batch', d, 'batch', 'batch'))
            .catch(() => alert('Batch list load nahi hui.'));
    });

    // ---------- Download ----------
    btnDownload.addEventListener('click', function () {

        if (!ddl.exam.value) { alert('Please select Exam.'); return; }
        if (!ddl.course.value) { alert('Please select Course.'); return; }
        if (!ddl.sem.value) { alert('Please select Semester.'); return; }
        if (!ddl.batch.value) { alert('Please select Batch.'); return; }
        if (!downloadType.value) { alert('Please select Download Type (Excel / CSV).'); return; }

        const ext = downloadType.value === 'csv' ? 'csv' : 'xlsx';
        const fileName = `Result_${selText(ddl.course)}_${selText(ddl.sem)}_${selText(ddl.batch)}.${ext}`
            .replace(/[^\w.\-]+/g, '_');

        const url = `${api}DownloadResult?exId=${ddl.exam.value}&courseId=${ddl.course.value}` +
                    `&semester=${ddl.sem.value}&batch=${encodeURIComponent(ddl.batch.value)}` +
                    `&downloadType=${downloadType.value}`;

        btnDownload.disabled = true;
        btnDownload.textContent = 'Downloading...';

        fetch(url)
            .then(r => {
                if (r.status === 404) throw new Error('NOT_FOUND');
                if (!r.ok) throw new Error(r.status);
                return r.blob();
            })
            .then(blob => {
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(() => URL.revokeObjectURL(a.href), 2000);
            })
            .catch(err => {
                alert(err.message === 'NOT_FOUND'
                    ? 'No records found for the selected filters.'
                    : 'Download failed. Please try again.');
            })
            .finally(() => {
                btnDownload.disabled = false;
                btnDownload.textContent = BTN_TEXT;
            });
    });
</script>