@{
    ViewData["Title"] = "Marksheet";
    Layout =null;
    @inject IConfiguration Configuration
    <script>
        var ApiBaseUrl = '@Configuration["ApiSettings:BaseUrl"]';
    </script>
}
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<title>Marks Statement - National Institute of Ayurveda</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Devanagari:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<style>
   @@page {
    size: A4 portrait;
    margin: 3mm 4mm;
  }
  html, body {
    margin: 0;
    padding: 0;
    background: #eef2f7;
    font-family: 'Times New Roman', Times, serif;
    font-size: 10px;
    color: #000;
    -webkit-font-smoothing: antialiased;
  }
  * {
    box-sizing: border-box;
  }
  .hi-text {
    font-family: 'Noto Serif Devanagari', 'Times New Roman', serif;
  }

  /* Top Action Bar (Screen Only) */
  .no-print-bar {
    text-align: center;
    padding: 12px 0 6px 0;
  }
  .print-btn {
    background-color: #254078;
    color: #ffffff;
    border: none;
    padding: 8px 22px;
    font-size: 13.5px;
    font-weight: bold;
    font-family: Arial, sans-serif;
    border-radius: 5px;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.18);
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .print-btn:hover {
    background-color: #1a2f58;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(0,0,0,0.25);
  }

  /* Outer & Inner Double Border Container */
  .outer-border {
    width: 196mm;
    min-height: 277mm;
    margin: 10px auto 25px auto;
    border: 2.5px solid #6b93cb;
    padding: 3px;
    background: #fff;
    box-sizing: border-box;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .sheet {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1.5px solid #6b93cb;
    padding: 3.5mm 5.5mm;
    position: relative;
    background: #fff;
    box-sizing: border-box;
  }

  /* Top Bar */
  .top-numbers {
    display: flex;
    justify-content: space-between;
    font-size: 11.5px;
    font-weight: bold;
    margin-bottom: 1px;
    color: #000;
    letter-spacing: -0.1px;
  }

  /* Header Row */
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1px;
  }
  .header-col-left {
    flex: 1;
    text-align: center;
  }
  .header-col-right {
    flex: 1;
    text-align: center;
  }
  .logo-col {
    flex: 0 0 120px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .logo-col img {
    height: 115px;
    width: 115px;
    object-fit: contain;
  }

  /* Headings */
  .inst-name-hi {
    font-size: 23px;
    font-weight: 800;
    margin: 0;
    line-height: 1.05;
    color: #000;
    letter-spacing: -0.2px;
  }
  .inst-sub-hi {
    font-size: 14px;
    font-weight: 700;
    margin: 2px 0 0 0;
    line-height: 1.12;
    color: #000;
  }
  .inst-addr-hi {
    font-size: 11.8px;
    font-weight: 600;
    margin: 1.5px 0 0 0;
    line-height: 1.15;
    color: #000;
  }

  .inst-name-en {
    font-size: 22px;
    font-weight: 700;
    margin: 0;
    line-height: 1.05;
    color: #000;
    font-family: 'Times New Roman', Times, serif;
    letter-spacing: -0.2px;
  }
  .inst-sub-en {
    font-size: 14px;
    font-weight: 700;
    margin: 2px 0 0 0;
    line-height: 1.12;
    color: #000;
    font-family: 'Times New Roman', Times, serif;
  }
  .inst-ministry-en {
    font-size: 11.8px;
    font-weight: bold;
    margin: 1.5px 0 0 0;
    line-height: 1.15;
    color: #5c90d2;
    font-family: 'Times New Roman', Times, serif;
  }
  .inst-addr-en {
    font-size: 11.8px;
    font-weight: 600;
    margin: 1px 0 0 0;
    line-height: 1.15;
    color: #000;
    font-family: 'Times New Roman', Times, serif;
  }

  /* Academic Row */
  .academic-row {
    display: flex;
    justify-content: space-between;
    margin-top: 4px;
  }
  .academic-col-left {
    flex: 1;
    text-align: center;
  }
  .academic-center-spacer {
    flex: 0 0 120px;
  }
  .academic-col-right {
    flex: 1;
    text-align: center;
  }

  .course-line-hi-main {
    font-size: 16.5px;
    font-weight: 800;
    margin: 0;
    line-height: 1.12;
    letter-spacing: -0.1px;
  }
  .course-line-hi-sub {
    font-size: 11.5px;
    font-weight: 700;
    margin: 1px 0 0 0;
    line-height: 1.15;
  }
  .course-line-en-main {
    font-size: 18.5px;
    font-weight: 700;
    margin: 0;
    line-height: 1.12;
    font-family: 'Times New Roman', Times, serif;
    letter-spacing: -0.1px;
  }
  .course-line-en-sub {
    font-size: 11.5px;
    font-weight: 700;
    margin: 1px 0 0 0;
    line-height: 1.15;
    font-family: 'Times New Roman', Times, serif;
  }
  .doc-title-hi {
    font-size: 17px;
    font-weight: 800;
    margin: 4px 0 0 0;
    line-height: 1.12;
  }
  .doc-title-en {
    font-size: 15.5px;
    font-weight: 700;
    margin: 4px 0 0 0;
    letter-spacing: 0.2px;
    font-family: 'Times New Roman', Times, serif;
  }
  .exam-held {
    font-size: 12px;
    font-weight: 700;
    margin: 1px 0 0 0;
    line-height: 1.12;
  }

  /* Student Info Table */
  .student-info {
    width: 100%;
    border-collapse: collapse;
    margin-top: 5px;
    margin-bottom: 3px;
    font-size: 11.5px;
  }
  .student-info td {
    padding: 1px 0;
    vertical-align: top;
    line-height: 1.25;
  }
  .student-info .label {
    font-weight: 700;
    white-space: nowrap;
  }

  /* Marks Table */
  table.marks {
    width: 100%;
    border-collapse: collapse;
    font-size: 8.5px;
    margin-top: 2px;
  }
  table.marks th, table.marks td {
    border: 1px solid #000;
    padding: 2px 1.5px;
    text-align: center;
    vertical-align: middle;
  }
  table.marks th {
    font-weight: bold;
    font-size: 8.5px;
    line-height: 1.1;
    background-color: #fff;
  }
  table.marks td {
    height: 30px;
    font-size: 9px;
    font-weight: bold;
  }
  table.marks td.subject-name {
    text-align: left;
    font-size: 8.5px;
    line-height: 1.18;
    padding-left: 3.5px;
    font-weight: bold;
  }
  table.marks td.distribution {
    font-size: 8px;
    line-height: 1.12;
    font-weight: bold;
  }
  .grand-total-row td {
    font-weight: bold;
    text-align: right;
    font-size: 10px;
    height: 20px;
  }

  /* Summary Table */
  table.summary {
    width: 100%;
    border-collapse: collapse;
    font-size: 8.5px;
    margin-top: -1px;
  }
  table.summary td {
    border: 1px solid #000;
    padding: 2.5px 3.5px;
    vertical-align: top;
    font-weight: bold;
    line-height: 1.18;
  }

  /* Notes & Result Section (Full 100% Width, Reduced Font Size to 8.5px, Font-Weight 600) */
  .notes-section {
    width: 100%;
    margin-top: 5px;
  }
  .notes-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 2px;
  }
  .notes-title {
    font-size: 10.5px;
    font-weight: 700;
  }
  .result-box {
    font-size: 13.5px;
    font-weight: bold;
    color: #000;
  }
  .notes-body {
    width: 100%;
    font-size: 8.5px;
    font-weight: 600;
    line-height: 1.25;
    color: #000;
  }
  .notes-body p {
    margin: 1.5px 0;
  }
  .notes-body strong {
    font-weight: 700;
  }

  /* Footer */
  .footer-block {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 8px;
    font-size: 9.8px;
    font-weight: bold;
    position: relative;
  }
  .place-date {
    text-align: left;
    line-height: 1.22;
  }
  .qr-center {
    text-align: center;
  }
  .qr-center img {
    width: 58px;
    height: 58px;
    object-fit: contain;
  }
  .signature {
    text-align: center;
  }
  .signature img {
    height: 38px;
    width: 125px;
    margin-bottom: -2px;
  }
  .serial-bottom {
    position: absolute;
    right: 0;
    bottom: -16px;
    font-size: 8px;
    font-weight: bold;
  }



        /* =====================================================
           PRINT POPUP
           ===================================================== */

        .print-modal {
            display: none;
            position: fixed;
            z-index: 99999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.55);
            align-items: center;
            justify-content: center;
        }


        .print-modal-content {
            width: 420px;
            max-width: 90%;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            animation: printModalOpen 0.2s ease;
        }


        @@keyframes printModalOpen {
            from

        {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }


        /* =====================================================
           HEADER
           ===================================================== */

        .print-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 20px;
            border-bottom: 1px solid #ddd;
        }


            .print-modal-header h3 {
                margin: 0;
                font-size: 19px;
                font-weight: 600;
            }


        .print-modal-close {
            border: none;
            background: transparent;
            font-size: 27px;
            line-height: 1;
            cursor: pointer;
            color: #666;
        }


            .print-modal-close:hover {
                color: #000;
            }


        /* =====================================================
           BODY
           ===================================================== */

        .print-modal-body {
            padding: 20px;
        }


        .print-input-group {
            margin-bottom: 16px;
        }


            .print-input-group label {
                display: block;
                margin-bottom: 6px;
                font-size: 14px;
                font-weight: 600;
                color: #333;
            }


        .print-input {
            width: 100%;
            box-sizing: border-box;
            padding: 10px 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            outline: none;
        }


            .print-input:focus {
                border-color: #555;
            }


        /* =====================================================
           FOOTER
           ===================================================== */

        .print-modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 15px 20px;
            border-top: 1px solid #ddd;
            background: #fafafa;
        }


        .print-cancel-btn,
        .print-save-btn {
            padding: 9px 16px;
            border-radius: 5px;
            border: none;
            cursor: pointer;
            font-size: 14px;
        }


        .print-cancel-btn {
            background: #e5e5e5;
            color: #333;
        }


        .print-save-btn {
            background: #222;
            color: #fff;
        }


            .print-save-btn:hover {
                opacity: 0.9;
            }


        /* =====================================================
           PRINT
           ===================================================== */

        @@media print {
            .print-modal

        {
            display: none !important;
        }

        }

  /* Strict Single-Page Print Optimization */
 @@media print {
    @@page {
      size: A4 portrait;
      margin: 3mm 4mm;
    }
    html, body {
      margin: 0 !important;
      padding: 0 !important;
      background: #fff !important;
      height: 100vh !important;
      max-height: 100vh !important;
      overflow: hidden !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    .no-print-bar {
      display: none !important;
    }
    .outer-border {
      width: 100% !important;
      height: calc(100vh - 6mm) !important;
      min-height: calc(100vh - 6mm) !important;
      max-height: calc(100vh - 6mm) !important;
      margin: 0 auto !important;
      border: 2.5px solid #6b93cb !important;
      padding: 3px !important;
      box-shadow: none !important;
      box-sizing: border-box !important;
      page-break-inside: avoid !important;
      page-break-after: avoid !important;
      display: flex !important;
      flex-direction: column !important;
    }
    .sheet {
      width: 100% !important;
      height: 100% !important;
      flex: 1 !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
      border: 1.5px solid #6b93cb !important;
      padding: 3mm 5mm !important;
      box-sizing: border-box !important;
      page-break-inside: avoid !important;
      page-break-after: avoid !important;
    }
    .footer-block {
      margin-top: auto !important;
    }
    .serial-bottom {
      bottom: -13px !important;
    }
  }
</style>
</head>
<body>

<div class="no-print-bar">
        <button type="button" onclick="openPrintPopup()" class="print-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            Print Marksheet / प्रिंट करें
        </button>
</div>

<div class="outer-border">
  <div class="sheet">

    <div class="top-numbers">
                <span><span class="hi-text">क्रम संख्या</span> /Serial No.: <span id="Serialno"></span></span>
                <span><span class="hi-text">फोलियों संख्या</span> /Folio No.:<span id="Folio"></span></span>
    </div>


            <div class="header-row">
                <div class="header-col-left">
                    <p class="inst-name-hi hi-text">राष्ट्रीय आयुर्वेद संस्थान</p>
                    <p class="inst-sub-hi hi-text">मानद विश्वविद्यालय</p>
                    <p class="inst-addr-hi hi-text">(आयुष मंत्रालय, भारत सरकार)<br>आमेर रोड, जयपुर-302002</p>
                </div>
                <div class="logo-col">
                    <img src="~/Logo/logo.webp" alt="National Institute of Ayurveda Logo">
                </div>
                <div class="header-col-right">
                    <p class="inst-name-en">National Institute of Ayurveda</p>
                    <p class="inst-sub-en">Deemed to be University</p>
                    <p class="inst-ministry-en">(Ministry of AYUSH, Govt. of India)</p>
                    <p class="inst-addr-en">Amer Road, Jaipur-302002</p>
                </div>
            </div>

            <div class="academic-row">
                <div class="academic-col-left">
                    <p class="course-line-hi-main hi-text">आयुर्वेदाचार्य-द्वितीय व्यावसायिक</p>
                    <p class="course-line-hi-sub hi-text">(आयुर्वेदिक चिकित्सा एवं शल्य चिकित्सा में स्नातक<br>बैचलर ऑफ आयुर्वेदिक मेडिसिन एण्ड सर्जरी- बी.ए.एम.एस)</p>
                    <p class="doc-title-hi hi-text">अंक विवरणिका</p>
                    <p class="exam-held hi-text">(परीक्षा सम्पादित जुलाई-अगस्त 2026)</p>
                </div>
                <div class="academic-center-spacer"></div>
                <div class="academic-col-right">
                    <p class="course-line-en-main">B.A.M.S. II Professional</p>
                    <p class="course-line-en-sub">(Bachelor of Ayurvedic Medicine and Surgery-B.A.M.S.)</p>
                    <p class="doc-title-en">MARKS STATEMENT</p>
                    <p class="exam-held">(Examination Held in July-August 2026)</p>
                </div>
            </div>

   

            <table class="student-info">
                <tr>
                    <td class="label" style="width:61%;">
                        <span class="hi-text">नाम/Name</span>:
                        <span class="hi-text" id="studentNameHindi"></span>
                        / <span id="studentName"></span>
                    </td>

                    <td class="label" style="width:39%;">
                        <span class="hi-text">अनुक्रमांक / Roll No.</span>:
                        <span id="rollNumber"></span>
                    </td>
                </tr>

                <tr>
                    <td class="label">
                        <span class="hi-text">पिता का नाम/Father's Name</span>:
                        <span class="hi-text" id="fatherNameHindi"></span>
                        / <span id="fatherName"></span>
                    </td>

                    <td class="label">
                        <span class="hi-text">नामांकन संख्या / Enrollment No.</span>:
                        <span id="enrollmentNumber"></span>
                    </td>
                </tr>

                <tr>
                    <td class="label">
                        <span class="hi-text">माता का नाम/Mother's Name</span>:
                        <span class="hi-text" id="motherNameHindi"></span>
                        / <span id="MotherName"></span>
                    </td>

                    <td class="label">
                        <span class="hi-text">प्रयास / Attempt</span>:
                        <span id="attempt"></span>
                    </td>
                </tr>
            </table>

    <table class="marks">
      <thead>
        <tr>
          <th rowspan="3" style="width:20%;"><span class="hi-text">विषय / पत्र</span><br>Subjects/Paper</th>
          <th rowspan="3" style="width:11%;"><span class="hi-text">अंक वितरण</span><br>Marks Distribution</th>
          <th rowspan="3" style="width:6%;"><span class="hi-text">अधिकतम अंक</span><br>Max. Marks<br>(2100)</th>
          <th rowspan="3" style="width:6%;"><span class="hi-text">न्यूनतम अंक</span><br>Min. Marks<br>(1050)</th>
          <th colspan="7"><span class="hi-text">प्राप्तांक</span> - Marks Obtained</th>
          <th rowspan="3" style="width:6%;"><span class="hi-text">टिप्पणी</span><br>Remark</th>
        </tr>
        <tr>
          <th rowspan="2" style="width:6.5%;"><span class="hi-text">सैद्धांतिक प्रथम</span><br>Theory I<br>(100)</th>
          <th rowspan="2" style="width:6.5%;"><span class="hi-text">सैद्धांतिक द्वितीय</span><br>Theory II<br>(100)</th>
          <th colspan="4" style="width:27%;"><span class="hi-text">व्यावहारिक या नैदानिक मूल्यांकन</span><br>Practical/Clinical Assessment</th>
          <th rowspan="2" style="width:7%;"><span class="hi-text">विषय योग</span><br>Subject Total</th>
        </tr>
        <tr>
          <th style="width:7.5%;"><span class="hi-text">व्यावहारिक या नैदानिक</span><br>Practical /Clinical<br>(100)</th>
          <th style="width:7%;"><span class="hi-text">साक्षात्कार</span><br>Viva<br />(*75)<br /> (#60)<br />(@@70)</th>
          <th style="width:6.5%;"><span class="hi-text">ऐच्छिक</span><br>Electives<br/>(10)</th>
          <th style="width:6%;"><span class="hi-text">आई.ए.</span><br>IA<br>(30)<br/>(*15)</th>
        </tr>
      </thead>
                <tbody id="marksTableBody">
                </tbody>

                <tfoot>
                    <tr class="grand-total-row">
                        <td colspan="10">
                            <span class="hi-text">कुल योग</span> / GRAND TOTAL
                        </td>
                        <td style="text-align:center;" id="grandTotal"></td>
                        <td></td>
                    </tr>
                </tfoot>
    </table>

    <table class="summary">
      <tr>
        <td style="width:25%;"><span class="hi-text">डिस्टिक्शन प्राप्तिः</span><br>Distinction secured: A-2</td>
        <td style="width:35%;"><span class="hi-text">प्रथम श्रेणी प्राप्तिः</span><br>First Class secured: A-1, A-3, A-5, A-6</td>
        <td style="width:20%;"><span class="hi-text">कृपांक प्राप्तिः</span><br>Grace Marks Awarded:</td>
        <td style="width:20%;"><span class="hi-text">अनुत्तीर्णः</span><br>Failed:</td>
      </tr>
    </table>

    <div class="notes-section">
      <div class="notes-header">
        <div class="notes-title"><strong><span class="hi-text">टिप्पणी</span> / Note:</strong></div>
        <div class="result-box"><span class="hi-text">परिणाम</span> / RESULT: <span class="hi-text">उत्तीर्ण</span>/PASS</div>
      </div>
      <div class="notes-body">
        <p>1. <span class="hi-text">एक विषय में उत्तीर्ण होने के लिए अभ्यर्थी को सैद्धांतिक और व्यावहारिक परीक्षा में से प्रत्येक में न्यूनतम 50% अंक प्राप्त करना आवश्यक है।</span><br>
        To pass a subject candidate requires to obtain a minimum of 50% marks in each of Theory and Practical Examination</p>
        <p>2. <span class="hi-text">किसी विषय में 65% या उससे अधिक अंक प्राप्त करने वाले अभ्यर्थी को उस विषय में प्रथम श्रेणी (I द्वारा चिन्हित) प्राप्त से उत्तीर्ण दिखाया जायेगा।</span><br>
        Candidate securing 65% marks or above in a Subject shall be declared to have obtained First Class (Denoted by I) in that Subject.</p>
        <p>3. <span class="hi-text">किसी विषय में 75% या उससे अधिक अंक प्राप्त करने वाले अभ्यर्थी को उस विषय में डिस्टिक्शन (D द्वारा चिन्हित) प्राप्त दिखाया जायेगा।</span><br>
        Candidate securing 75% marks or above in a Subject shall be declared to have obtained distinction (Denoted by D) in that Subject.</p>
        <p>4. <span class="hi-text">किसी पेपर के सैद्धांतिक या व्यावहारिक भाग में अनुत्तीर्ण होने वाले अभ्यर्थी को उस विषय में अनुत्तीर्ण माना जाएगा।</span><br>
        Candidate falling in the Theory or practical of a paper will be considered fail in that subject.</p>
        <p>5. <span class="hi-text">अंक - विवरणिका तैयार करने के दौरान यदि कोई त्रुटि हो जाती है और बाद में ध्यान में लाई जाती है, तो उसे ठीक करने का पूर्ण अधिकार विश्वविद्यालय के पास होगा।</span><br>
        In case of any mistake occurred during the preparation of marks-statement brought to notice afterwards, the University will be fully empowered to correct the same.</p>
        <p>6. <span class="hi-text">D-डिस्टिक्शन I-प्रथम श्रेणी G-कृपांक F-अनुत्तीर्ण AB-अनुपस्थित सै.-सैद्धांतिक व्याव.-व्यावहारिक आई.ए.-आंतरिक मूल्यांकन</span><br>
        D-Distinction I-First Class G-Grace F-Fall AB-Absent Th.-Theory Pr-Practical IA-Internal Assessment</p>
        <p>7. Max.-Maximum Min.-Minimum</p>
      </div>
