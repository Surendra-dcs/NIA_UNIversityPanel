    <script>

    // ============================================================
    // DOCUMENT READY
    // ============================================================

    $(document).ready(function () {

        loadmarksheet();

    });


    // ============================================================
    // GET API VALUE - CASE INSENSITIVE
    // ============================================================

    function getValue(obj, propertyName) {

        if (!obj) {
            return "";
        }

        let key = Object.keys(obj).find(function (k) {

            return k.toLowerCase() === propertyName.toLowerCase();

        });

        if (key === undefined) {
            return "";
        }

        if (
            obj[key] === null ||
            obj[key] === undefined
        ) {
            return "";
        }

        return obj[key];

    }


    // ============================================================
    // DISPLAY VALUE
    // ============================================================

    function displayValue(value, defaultValue = "-") {

        if (
            value === null ||
            value === undefined ||
            value === ""
        ) {

            return defaultValue;

        }

        return value;

    }


    // ============================================================
    // NORMAL MARK FORMAT
    //
    // Agar API se:
    // @@51
    // @@51
    // #35
    // *52
    //
    // aaye to sahi format me show karega.
    // ============================================================

  
function formatMarks(value) {

    if (
        value === null ||
        value === undefined ||
        value === ""
    ) {

        return "-";

    }

    let mark =
        value.toString().trim();


    if (
        mark.startsWith("@@") ||
        mark.startsWith("#") ||
        mark.startsWith("*")
    ) {

        return mark;

    }

    return mark;

}



    // ============================================================
    // GET SUBJECT CODE
    //
    // (A-1) DRAVYAGUNA VIGYAN
    //       ↓
    // A-1
    // ============================================================

          function getSubjectCode(subjectName) {

            if (
                subjectName === null ||
                subjectName === undefined ||
                subjectName === ""
            ) {

                return "";
            }
            let text =
                subjectName.toString().trim();
            let parenMatch =
                text.match(/\(([A-Za-z]-\d+)\)/);
            if (parenMatch) {
                return parenMatch[1].toUpperCase();
            }

            let leadingMatch =
                text.match(/^([A-Za-z]-\d+)/);
            if (leadingMatch) {
                return leadingMatch[1].toUpperCase();
            }
            return "";

        }


    // ============================================================
    // VIVA FORMAT
    //
    // A-1 = @@
    // A-2 = @@
    // A-3 = @@
    // A-4 = #
    // A-5 = *
    // A-6 = #
    // ============================================================

 function formatViva(value, subjectName) {

    if (
        value === null ||
        value === undefined ||
        value === ""
    ) {

        return "-";

    }

    let mark =
        value.toString().trim();


    // ========================================================
    // AGAR API SE ALREADY PREFIX AAYA HAI
    // ========================================================

    if (
        mark.startsWith("@@") ||
        mark.startsWith("#") ||
        mark.startsWith("*")
    ) {

        return mark;

    }


    let subjectCode =
        getSubjectCode(subjectName);


    switch (subjectCode) {

        case "A-1":
            return "@@" + mark;

        case "A-2":
            return "@@" + mark;

        case "A-3":
            return "@@" + mark;

        case "A-4":
            return "#" + mark;

        case "A-5":
            return "*" + mark;

        case "A-6":
            return "#" + mark;

        default:
            return mark;

    }

}


    // ============================================================
    // IA FORMAT
    //
    // A-5 = *12
    // बाकी normal
    // ============================================================

   // A-5 = *value
// बाकी normal
// ============================================================

function formatIA(value, subjectName) {

    if (
        value === null ||
        value === undefined ||
        value === ""
    ) {

        return "-";

    }

    let mark =
        value.toString().trim();


    if (
        mark.startsWith("@@") ||
        mark.startsWith("#") ||
        mark.startsWith("*")
    ) {

        return mark;

    }


    let subjectCode =
        getSubjectCode(subjectName);


    if (subjectCode === "A-5") {

        return "*" + mark;

    }

    return mark;

}

    // ============================================================
    // RESULT FAIL CHECK
    // ============================================================

    function isFail(result) {

        if (
            result === null ||
            result === undefined ||
            result === ""
        ) {

            return false;

        }

        let value =
            result.toString()
                .trim()
                .toUpperCase();


        return (
            value === "FAIL" ||
            value === "F"
        );

    }


    // ============================================================
    // LOAD MARKSHEET
    // ============================================================

    function loadmarksheet() {

        let enrollment =
            '@ViewBag.enrollment';


        $.ajax({

            url:
                ApiBaseUrl +
                `Result/getdataformarksheet?enrollment=${encodeURIComponent(enrollment)}`,

            method: "GET",


            // ====================================================
            // SUCCESS
            // ====================================================

            success: function (data) {

                console.log(
                    "Marksheet API Data:",
                    data
                );


                // =================================================
                // CHECK DATA
                // =================================================

                if (
                    !data ||
                    !Array.isArray(data) ||
                    data.length === 0
                ) {

                    $("#marksTableBody").html(`

                        <tr>

                            <td
                                colspan="12"
                                style="text-align:center;"
                            >
                                No record found
                            </td>

                        </tr>

                    `);

                    return;

                }


                // =================================================
                // FIRST RECORD
                // =================================================

                let student =
                    data[0];


                // =================================================
                // STUDENT DETAILS
                // =================================================





                $("#studentName").text(

                    displayValue(
                        getValue(
                            student,
                                  "FirstName"
                        ),
                        ""
                    )

                );

                                 $("#studentNameHindi").text(

                            displayValue(
                                getValue(
                                    student,
                                                  "StudentHindiName"
                                ),
                                ""
                            )

                        );

                $("#fatherName").text(

                    displayValue(
                        getValue(
                            student,
                                   "FatherName"
                        ),
                        ""
                    )

                );



                                $("#fatherNameHindi").text(

                            displayValue(
                                getValue(
                                    student,
                                                   "FatherNameHindi"
                                ),
                                ""
                            )

                        );

                     $("#MotherName").text(

                            displayValue(
                                getValue(
                                    student,
                                    "MotherName"
                                ),
                                ""
                            )

                        );

                                          $("#motherNameHindi").text(

                                    displayValue(
                                        getValue(
                                            student,
                                                    "MotherNameHindi"
                                        ),
                                        ""
                                    )

                                );

                $("#rollNumber").text(

                    displayValue(
                        getValue(
                            student,
                            "RollNumber"
                        ),
                        ""
                    )

                );


                $("#enrollmentNumber").text(

                    displayValue(
                        getValue(
                            student,
                            "EnrollmentNumber"
                        ),
                        enrollment
                    )

                );


                $("#attempt").text(

                    displayValue(
                        getValue(
                            student,
                            "Attempt"
                        ),
                        ""
                    )

                );


                // =================================================
                // EXAM NAME
                // =================================================

                let examName =
                    getValue(
                        student,
                        "Examname"
                    );


                if (examName !== "") {

                    $(".exam-h").text(
                        "Examination Held in " +
                        examName
                    );

                }


                // =================================================
                // TABLE BODY
                // =================================================

                let tbody =
                    $("#marksTableBody");


                tbody.empty();


                // =================================================
                // GRAND TOTAL CALCULATION
                // =================================================

                let calculatedGrandTotal = 0;


                // =================================================
                // SUMMARY ARRAYS
                // =================================================

                let distinctionSubjects = [];

                let firstClassSubjects = [];

                let graceMarks = [];

                let failedSubjects = [];


                // =================================================
                // SUBJECT LOOP
                // =================================================

                $.each(
                    data,
                    function (index, item) {


                        // =========================================
                        // SUBJECT NAME
                        // =========================================

                        let subjectName =
                            getValue(
                                item,
                                "subjectName"
                            );


                        let subjectHindiName =
                            getValue(
                                item,
                                "subjectHindiName"
                            );


                        // =========================================
                        // SUBJECT CODE
                        // =========================================

                        let subjectCode =
                            getSubjectCode(
                                subjectName
                            );


                               // =========================================
        // MARKS DISTRIBUTION
        // (Max marks ka sum chahiye - obtained ka nahi)
        // =========================================

        let theoryI_max =
            parseFloat(
                getValue(
                    item,
                    "TheoryI"
                )
            );

        let theoryII_max =
            parseFloat(
                getValue(
                    item,
                    "TheoryII"
                )
            );

        let theoryTotal =
            (
                (isNaN(theoryI_max) ? 0 : theoryI_max) +
                (isNaN(theoryII_max) ? 0 : theoryII_max)
            );


        let practical_max =
            parseFloat(
                getValue(
                    item,
                    "Practical"
                )
            );

        let viva_max =
            parseFloat(
                getValue(
                    item,
                    "VivaMarks"
                )
            );

        let elective_max =
            parseFloat(
                getValue(
                    item,
                    "ElectiveMarks"
                )
            );

        let ia_max =
            parseFloat(
                getValue(
                    item,
                    "IAMarks"
                )
            );

        let practicalTotal =
            (
                (isNaN(practical_max) ? 0 : practical_max) +
                (isNaN(viva_max) ? 0 : viva_max) +
                (isNaN(elective_max) ? 0 : elective_max) +
                (isNaN(ia_max) ? 0 : ia_max)
            );


        let distribution = "";

        if (
            theoryTotal > 0 ||
            practicalTotal > 0
        ) {

            distribution = `

                सै. ${displayValue(
                    theoryTotal,
                    ""
                )}

                Th ${displayValue(
                    theoryTotal,
                    ""
                )}

                <br>

                व्याव. ${displayValue(
                    practicalTotal,
                    ""
                )}

                Pr ${displayValue(
                    practicalTotal,
                    ""
                )}

            `;

        }


                        // =========================================
                        // MAX MARKS
                        // =========================================

                        let maxMarks =
                            getValue(
                                item,
                                "GrandTotalMarks"
                            );


                        // =========================================
                        // MIN MARKS
                        // =========================================

                        let minMarks =
                            getValue(
                                item,
                                "MinTotalMarks"
                            );


                        // =========================================
                        // MIN MARKS NOT FROM API
                        // MAX / 2
                        // =========================================

                        if (
                            minMarks === "" &&
                            maxMarks !== ""
                        ) {

                            let max =
                                parseFloat(
                                    maxMarks
                                );


                            if (!isNaN(max)) {

                                minMarks =
                                    max / 2;

                            }

                        }


                        // =========================================
                        // THEORY I
                        // =========================================

                        let theoryI =
                            getValue(
                                item,
                                "FinalTheoryIMarks"
                            );


                        if (theoryI === "") {

                            theoryI =
                                getValue(
                                    item,
                                    "TheoryI"
                                );

                        }


                        // =========================================
                        // THEORY II
                        // =========================================

                        let theoryII =
                            getValue(
                                item,
                                "FinalTheoryIIMarks"
                            );


                        if (theoryII === "") {

                            theoryII =
                                getValue(
                                    item,
                                    "TheoryII"
                                );

                        }


                        // =========================================
                        // PRACTICAL
                        // =========================================

                        let practical =
                            getValue(
                                item,
                                "ObtenPracticalMarks"
                            );


                        if (practical === "") {

                            practical =
                                getValue(
                                    item,
                                    "Practical"
                                );

                        }


                        // =========================================
                        // VIVA
                        // =========================================

                        let viva =
                            getValue(
                                item,
                                "ObtenVivaMarks"
                            );


                        if (viva === "") {

                            viva =
                                getValue(
                                    item,
                                    "VivaMarks"
                                );

                        }


                        // =========================================
                        // ELECTIVE
                        // =========================================

                        let elective =
                            getValue(
                                item,
                                "ObtenElativeMarks"
                            );


                        if (elective === "") {

                            elective =
                                getValue(
                                    item,
                                    "ElectiveMarks"
                                );

                        }


                        // =========================================
                        // IA
                        // =========================================

                        let ia =
                            getValue(
                                item,
                                "ObtenIAMarks"
                            );


                        if (ia === "") {

                            ia =
                                getValue(
                                    item,
                                    "IAMarks"
                                );

                        }


                        // =========================================
                        // SUBJECT TOTAL
                        // =========================================

                        let subjectTotal =
                            getValue(
                                item,
                                "subjectTotal"
                            );


                        let totalNumber =
                            parseFloat(
                                subjectTotal
                            );


                        if (!isNaN(totalNumber)) {

                            calculatedGrandTotal +=
                                totalNumber;

                        }


                        // =========================================
                        // DISTINCTION
                        // =========================================

                        let distinction =
                            getValue(
                                item,
                                "Distinction"
                            );


                        // =========================================
                        // RESULT
                        // =========================================

                        let result =
                            getValue(
                                item,
                                "Result"
                            );


                        // =========================================
                        // REMARK
                        // =========================================

                        let remark =
                            distinction;


                        if (isFail(result)) {

                            remark = "F";

                        }


                        // =========================================
                        // DISTINCTION VALUE
                        // =========================================

                        let distinctionValue =
                            distinction
                                .toString()
                                .trim()
                                .toUpperCase();


                        // =========================================
                        // DISTINCTION
                        // =========================================

                        if (
                            distinctionValue === "D"
                        ) {

                            distinctionSubjects.push(
                                subjectCode
                            );

                        }


                        // =========================================
                        // FIRST CLASS
                        // =========================================

                        if (
                            distinctionValue === "I"
                        ) {

                            firstClassSubjects.push(
                                subjectCode
                            );

                        }


                        // =========================================
                        // GRACE MARKS
                        // =========================================

                        let grace =
                            getValue(
                                item,
                                "GraceMarks"
                            );


                        if (
                            grace !== "" &&
                            parseFloat(grace) > 0
                        ) {

                            graceMarks.push(
                                subjectCode +
                                " (" +
                                grace +
                                ")"
                            );

                        }


                        // =========================================
                        // FAILED
                        // =========================================

                        if (
                            isFail(result)
                        ) {

                            failedSubjects.push(
                                subjectCode
                            );

                        }


                        // =================================================
                        // APPEND ROW
                        // =================================================

                        tbody.append(`

                            <tr>


                                <!-- =============================== -->
                                <!-- SUBJECT -->
                                <!-- =============================== -->

                                <td class="subject-name">

                                    ${displayValue(
                                        subjectHindiName,
                                        ""
                                    )}

                                    ${
                                        subjectHindiName !== ""
                                            ? "<br>"
                                            : ""
                                    }

                                    ${displayValue(
                                        subjectName,
                                        ""
                                    )}

                                </td>


                                <!-- =============================== -->
                                <!-- MARKS DISTRIBUTION -->
                                <!-- =============================== -->

                                <td class="distribution">

                                    ${distribution}

                                </td>


                                <!-- =============================== -->
                                <!-- MAX -->
                                <!-- =============================== -->

                                <td>

                                    ${displayValue(
                                        maxMarks
                                    )}

                                </td>


                                <!-- =============================== -->
                                <!-- MIN -->
                                <!-- =============================== -->

                                <td>

                                    ${displayValue(
                                        minMarks
                                    )}

                                </td>


                                <!-- =============================== -->
                                <!-- THEORY I -->
                                <!-- =============================== -->

                                <td>

                                    ${formatMarks(
                                        theoryI
                                    )}

                                </td>


                                <!-- =============================== -->
                                <!-- THEORY II -->
                                <!-- =============================== -->

                                <td>

                                    ${formatMarks(
                                        theoryII
                                    )}

                                </td>


                                <!-- =============================== -->
                                <!-- PRACTICAL -->
                                <!-- =============================== -->

                                <td>

                                    ${formatMarks(
                                        practical
                                    )}

                                </td>


                                <!-- =============================== -->
                                <!-- VIVA -->
                                <!-- =============================== -->

                                <td>

                                    ${formatViva(
                                        viva,
                                        subjectName
                                    )}

                                </td>


                                <!-- =============================== -->
                                <!-- ELECTIVE -->
                                <!-- =============================== -->

                                      <td>
            ${formatElective(
                elective,
                subjectName
            )}
        </td>


                                <!-- =============================== -->
                                <!-- IA -->
                                <!-- =============================== -->

                                <td>

                                    ${formatIA(
                                        ia,
                                        subjectName
                                    )}

                                </td>


                                <!-- =============================== -->
                                <!-- SUBJECT TOTAL -->
                                <!-- =============================== -->

                                <td>

                                    ${formatMarks(
                                        subjectTotal
                                    )}

                                </td>


                                <!-- =============================== -->
                                <!-- REMARK -->
                                <!-- =============================== -->

                                <td>

                                    ${displayValue(
                                        remark,
                                        ""
                                    )}

                                </td>


                            </tr>

                        `);

                    }
                );


                // ====================================================
                // GRAND TOTAL
                // ====================================================

                let apiGrandTotal =
                    getValue(
                        student,
                        "GrandTotal"
                    );


                if (apiGrandTotal !== "") {

                    $("#grandTotal").text(
                        formatMarks(
                            apiGrandTotal
                        )
                    );

                }
                else {

                    $("#grandTotal").text(
                        formatMarks(
                            calculatedGrandTotal
                        )
                    );

                }


                // ====================================================
                // SUMMARY
                // ====================================================

                let summaryRow =
                    $(".summary tr");


                if (summaryRow.length > 0) {

                    let cells =
                        summaryRow.find("td");


                    // =================================================
                    // DISTINCTION
                    // =================================================

                    if (cells.length > 0) {

                        $(cells[0]).html(`

                            <span class="hi-text">
                                डिस्टिक्शन प्राप्तिः
                            </span>

                            <br>

                            Distinction secured:

                            ${
                                distinctionSubjects.length > 0
                                    ? distinctionSubjects.join(", ")
                                    : ""
                            }

                        `);

                    }


                    // =================================================
                    // FIRST CLASS
                    // =================================================

                    if (cells.length > 1) {

                        $(cells[1]).html(`

                            <span class="hi-text">
                                प्रथम श्रेणी प्राप्तिः
                            </span>

                            <br>

                            First Class secured:

                            ${
                                firstClassSubjects.length > 0
                                    ? firstClassSubjects.join(", ")
                                    : ""
                            }

                        `);

                    }


                    // =================================================
                    // GRACE
                    // =================================================

                    if (cells.length > 2) {

                        $(cells[2]).html(`

                            <span class="hi-text">
                                कृपांक प्राप्तिः
                            </span>

                            <br>

                            Grace Marks Awarded:

                            ${
                                graceMarks.length > 0
                                    ? graceMarks.join(", ")
                                    : ""
                            }

                        `);

                    }


                    // =================================================
                    // FAILED
                    // =================================================

                    if (cells.length > 3) {

                        $(cells[3]).html(`

                            <span class="hi-text">
                                अनुत्तीर्णः
                            </span>

                            <br>

                            Failed:

                            ${
                                failedSubjects.length > 0
                                    ? failedSubjects.join(", ")
                                    : ""
                            }

                        `);

                    }

                }


                // ====================================================
                // FINAL RESULT
                // ====================================================

                let finalResult =
                    getValue(
                        student,
                        "Result"
                    );


                if ($(".result-box").length > 0) {

                    $(".result-box").html(`

                        <span class="hi-text">
                            परिणाम
                        </span>

                        / RESULT:

                        <span class="hi-text">

                            ${displayValue(
                                finalResult,
                                ""
                            )}

                        </span>

                        /

                        ${displayValue(
                            finalResult,
                            ""
                        )}

                    `);

                }


                // ====================================================
                // SERIAL NO
                // ====================================================

                let serialNo =
                    getValue(
                        student,
                        "SerialNo"
                    );


                if (
                    serialNo !== "" &&
                    $("#Serialno").length > 0
                ) {

                    $("#Serialno").text(
                        serialNo
                    );

                }


                // ====================================================
                // FOLIO
                // ====================================================

                let folioNo =
                    getValue(
                        student,
                        "Folio"
                    );


                if (
                    folioNo !== "" &&
                    $("#Folio").length > 0
                ) {

                    $("#Folio").text(
                        folioNo
                    );

                }


                // ====================================================
                // BOTTOM SERIAL
                // ====================================================

                let serialBottom =
                    getValue(
                        student,
                        "SerialBottom"
                    );


                if (
                    serialBottom !== "" &&
                    $("#serialbottom").length > 0
                ) {

                    $("#serialbottom").text(
                        serialBottom
                    );

                }

            },


            // ====================================================
            // AJAX ERROR
            // ====================================================

            error: function (
                xhr,
                status,
                error
            ) {

                console.error(
                    "Marksheet API Error:",
                    error
                );


                console.error(
                    "API Response:",
                    xhr.responseText
                );


                alert(
                    "Failed to load marksheet data."
                );

            }
        });
      }
            function formatElective(value, subjectName) {

            let subjectCode =
                getSubjectCode(subjectName);


            if (
                value === null ||
                value === undefined ||
                value === "" ||
                parseFloat(value) === 0
            ) {

                // A-4/A-5/A-6 के लिए bhi value blank/0 ho to "-"
                return "-";

            }

            let mark =
                value.toString().trim();


            switch (subjectCode) {

                case "A-4":
                            return mark + "<br/> (Set-SA)";

                case "A-5":
                            return mark + "<br/> (Set-SB)";

                case "A-6":
                            return mark + "<br/> (Set-SC)";

                default:
                    return "-";

            }

        }

    // ============================================================
    // PRINT POPUP OPEN
    // ============================================================

    function openPrintPopup() {

        $("#printModal").css(
            "display",
            "flex"
        );


        $("#printSerialNo").val(
            $("#Serialno")
                .text()
                .trim()
        );


        $("#printFolioNo").val(
            $("#Folio")
                .text()
                .trim()
        );


        $("#printBottomSerial").val(
            $("#serialbottom")
                .text()
                .trim()
        );


        $("#printSerialNo").focus();

    }


    // ============================================================
    // CLOSE PRINT POPUP
    // ============================================================

    function closePrintPopup() {

        $("#printModal").hide();

    }


    // ============================================================
    // SAVE AND PRINT
    // ============================================================

    function saveAndPrint() {

        let serialNo =
            $("#printSerialNo")
                .val()
                .trim();


        let folioNo =
            $("#printFolioNo")
                .val()
                .trim();


        let bottomSerialNo =
            $("#printBottomSerial")
                .val()
                .trim();


        // ========================================================
        // SERIAL VALIDATION
        // ========================================================

        if (serialNo === "") {

            alert(
                "Please enter Serial No."
            );

            $("#printSerialNo").focus();

            return;

        }


        // ========================================================
        // FOLIO VALIDATION
        // ========================================================

        if (folioNo === "") {

            alert(
                "Please enter Folio No."
            );

            $("#printFolioNo").focus();

            return;

        }


        // ========================================================
        // BOTTOM SERIAL VALIDATION
        // ========================================================

        if (bottomSerialNo === "") {

            alert(
                "Please enter Bottom Serial No."
            );

            $("#printBottomSerial").focus();

            return;

        }


        // ========================================================
        // SET VALUES IN MARKSHEET
        // ========================================================

        $("#Serialno").text(
            serialNo
        );


        $("#Folio").text(
            folioNo
        );


        $("#serialbottom").text(
            bottomSerialNo
        );


        // ========================================================
        // CLOSE POPUP
        // ========================================================

        closePrintPopup();


        // ========================================================
        // PRINT AFTER DOM UPDATE
        // ========================================================

        setTimeout(function () {

            window.print();

        }, 200);

    }


    // ============================================================
    // ESC KEY - CLOSE PRINT POPUP
    // ============================================================

    $(document).on(
        "keydown",
        function (e) {

            if (
                e.key === "Escape" &&
                $("#printModal").is(":visible")
            ) {

                closePrintPopup();

            }

        }
    );


    // ============================================================
    // CLICK OUTSIDE POPUP TO CLOSE
    // ============================================================

    $(document).on(
        "click",
        "#printModal",
        function (e) {

            if (
                e.target === this
            ) {

                closePrintPopup();

            }

        }
    );


</script>
